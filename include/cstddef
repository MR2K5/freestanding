#pragma once

#include <stddef.h>

#define FWD(x) static_cast<decltype(x)>(x)

namespace std {

using ::max_align_t;
using ::nullptr_t;
using ::ptrdiff_t;
using ::size_t;

enum class byte : unsigned char {};

// A zero-overhead C++20/C++26 concept powered by Clang's internal compiler intrinsic
template<typename T> concept __integral_type = __is_integral(T);

// ============================================================================
// Bitwise Shift Operators (Constrained to Integral Types)
// ============================================================================

template<__integral_type IntType> constexpr byte operator<<(byte b, IntType shift) noexcept {
    return static_cast<byte>(static_cast<unsigned char>(b) << shift);
}

template<__integral_type IntType> constexpr byte& operator<<=(byte& b, IntType shift) noexcept {
    return b = b << shift;
}

template<__integral_type IntType> constexpr byte operator>>(byte b, IntType shift) noexcept {
    return static_cast<byte>(static_cast<unsigned char>(b) >> shift);
}

template<__integral_type IntType> constexpr byte& operator>>=(byte& b, IntType shift) noexcept {
    return b = b >> shift;
}

// ============================================================================
// Bitwise Logic Operators
// ============================================================================

constexpr byte operator|(byte l, byte r) noexcept {
    return static_cast<byte>(static_cast<unsigned char>(l) | static_cast<unsigned char>(r));
}

constexpr byte& operator|=(byte& l, byte r) noexcept {
    return l = l | r;
}

constexpr byte operator&(byte l, byte r) noexcept {
    return static_cast<byte>(static_cast<unsigned char>(l) & static_cast<unsigned char>(r));
}

constexpr byte& operator&=(byte& l, byte r) noexcept {
    return l = l & r;
}

constexpr byte operator^(byte l, byte r) noexcept {
    return static_cast<byte>(static_cast<unsigned char>(l) ^ static_cast<unsigned char>(r));
}

constexpr byte& operator^=(byte& l, byte r) noexcept {
    return l = l ^ r;
}

constexpr byte operator~(byte b) noexcept {
    return static_cast<byte>(~static_cast<unsigned char>(b));
}

template<__integral_type IntType> constexpr IntType to_integer(byte b) noexcept {
    return static_cast<IntType>(static_cast<unsigned char>(b));
}

}  // namespace std
