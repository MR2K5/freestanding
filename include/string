    constexpr bool starts_with(basic_string_view<Ch, Tr> x) const noexcept {
        return view_type(*this).starts_with(x);
    }
    constexpr bool starts_with(Ch x) const noexcept { return view_type(*this).starts_with(x); }
    constexpr bool starts_with(Ch const* x) const { return view_type(*this).starts_with(x); }
    constexpr bool ends_with(basic_string_view<Ch, Tr> x) const noexcept {
        return view_type(*this).ends_with(x);
    }
    constexpr bool ends_with(Ch x) const noexcept { return view_type(*this).ends_with(x); }
    constexpr bool ends_with(Ch const* x) const { return view_type(*this).ends_with(x); }

    constexpr bool contains(basic_string_view<Ch, Tr> x) const noexcept {
        return view_type(*this).contains(x);
    }
    constexpr bool contains(Ch x) const noexcept { return view_type(*this).contains(x); }
    constexpr bool contains(Ch const* x) const { return view_type(*this).contains(x); }

private:
    static constexpr size_t short_bytes       = sizeof(pointer) + 2 * sizeof(size_type);
    static constexpr size_t short_capacity    = short_bytes / sizeof(Ch) - 1;  // Null byte
    static constexpr size_type long_flag_mask = size_type(1) << (sizeof(size_type) * 8 - 1);
    static_assert(endian::native == endian::little);

    struct long_t {
        pointer ptr_;
        size_type size_;
        size_type cap_;  // Use last bit for marking short. this is the msb of cap: and msb of
                         // short[short_capacity]
    };

    union {
        Ch short_[short_capacity + 1]{};
        long_t long_;
    } store;
    [[no_unique_address]] Allocator alloc_;

    constexpr bool __is_short() const noexcept {
        if consteval {
            return std::is_within_lifetime(std::addressof(store.short_));
        } else {
            return (reinterpret_cast<char const*>(&store)[short_bytes - 1] & 0x80) == 0;
        }
    }
    constexpr size_type __short_size() const noexcept {
        assert(__is_short());
        return short_capacity - store.short_[short_capacity];
    }
    constexpr size_type __long_size() const noexcept {
        assert(!__is_short());
        return store.long_.size_;
    }

    constexpr size_type __short_cap() const noexcept {
        assert(__is_short());
        return short_capacity;
    }
    constexpr size_type __long_cap() const noexcept {
        assert(!__is_short());
        return store.long_.cap_ & ~long_flag_mask;
    }

    constexpr Ch* __long_data() noexcept {
        assert(!__is_short());
        return std::to_address(store.long_.ptr_);
    }
    constexpr Ch const* __long_data() const noexcept {
        assert(!__is_short());
        return std::to_address(store.long_.ptr_);
    }

    constexpr Ch* __short_data() noexcept {
        assert(__is_short());
        return store.short_;
    }
    constexpr Ch const* __short_data() const noexcept {
        assert(__is_short());
        return store.short_;
    }

    constexpr void __set_long_size(size_type nw) noexcept {
        assert(!__is_short());
        store.long_.size_ = nw;
    }
    constexpr void __set_short_size(size_type nw) noexcept {
        assert(__is_short());
        assert(nw <= short_capacity);
        store.short_[short_capacity] = short_capacity - nw;
    }
    constexpr void __set_size(size_type nw) noexcept {
        __is_short() ? __set_short_size(nw) : __set_long_size(nw);
    }
    constexpr void __set_long_cap(size_type nw) noexcept {
        assert(!__is_short());
        assert((nw & long_flag_mask) == 0);
        store.long_.cap_ = nw | long_flag_mask;
    }

    constexpr void __engage_long(pointer ptr, size_type sz, size_type cap) noexcept {
        assert(__is_short());
        assert((cap & long_flag_mask) == 0);
        ::new ((void*)&store.long_) long_t{std::move(ptr), sz, cap | long_flag_mask};
    }
    constexpr void __disengage_long(size_type short_sz) noexcept {
        assert(!__is_short());
        store.long_.~long_t();
        new ((void*)store.short_) Ch[short_capacity + 1];
        store.short_[short_sz]       = Ch(0);
        store.short_[short_capacity] = short_capacity - short_sz;
    }
    constexpr void __deallocate_long(size_type short_sz) noexcept {
        assert(!__is_short());
        auto req = __long_cap() + 1;
        Atr::deallocate(alloc_, store.long_.ptr_, req);
        __disengage_long(short_sz);
    }

    // Allocates storage for at least sz and sets the size
    constexpr void __ctor_reserve(size_t cap) {
        if (cap <= __short_cap()) return;
        if (cap > max_size()) _THROW(length_error("string"));

        assert((cap & long_flag_mask) == 0);
        // NOTE here the math needs to know endianness
        auto [p, c] = Atr::allocate_at_least(alloc_, cap + 1);
        if consteval { ::new (std::to_address(p)) Ch[c]; }
        // Mask the msb. if it is set then we can pass this bigger value too...
        // TODO should we set to largest value then? (-1) >> 1 this isn't exactly a likely case
        __engage_long(p, 0, (c - 1) & ~long_flag_mask);
    }

    // Resize space for sz chars.
    constexpr void __ctor_resize(size_type sz) {
        __ctor_reserve(sz);
        __set_size(sz);
    }

    constexpr void __set_short_null() noexcept {
        Tr::assign(__short_data()[__short_size()], Ch(0));
    }
    constexpr void __set_long_null() noexcept { Tr::assign(__long_data()[__long_size()], Ch(0)); }
    constexpr void __set_null() noexcept { Tr::assign(data()[size()], Ch()); }

    [[nodiscard]] constexpr size_type __calculate_growth(size_type target_size) const {
        size_type const max_cap = Atr::max_size(alloc_);

        // Prevent overflow: if cap_ is already large, cap_ + (cap_ >> 1) could wrap
        if (capacity() > max_cap - (capacity() >> 1)) { return max_cap; }

        // 1.5x integer growth: cap + (cap / 2)
        // Seed with 4 when empty
        size_type const geometric = capacity() + (capacity() >> 1);

        // Pick whichever is larger: the geometric step or the exact target
        return std::ranges::max(target_size, geometric);
    }

    constexpr void __move_long(basic_string&& o) noexcept {
        assert(!o.__is_short());
        if (!__is_short()) __deallocate_long(0);

        __engage_long(std::move(o.store.long_.ptr_), o.__long_size(), o.__long_cap());
        o.__disengage_long(0);
    }

    constexpr bool __is_aliasing_pointer(Ch const* ptr) {
        if consteval {
            return true;
        } else {
            return std::ranges::less_equal()(data(), ptr)
                && std::ranges::less_equal()(ptr, data() + size());
        }
    }
};

