// Asks if T* can alias U*
template<class T, class U>
inline constexpr bool __may_alias_v =
    // 1. Same underlying type (ignoring const/volatile)
    std::same_as<std::remove_cv_t<T>, std::remove_cv_t<U>> ||
    // 2. Signed/Unsigned integer/char variants of identical size
    (std::integral<T> && std::integral<U> && sizeof(T) == sizeof(U)
     && !std::same_as<T, bool> && !std::same_as<U, bool>)
    ||
    // 3. T is a universal byte-aliasing type inspecting U
    (std::same_as<std::remove_cv_t<T>, char> || std::same_as<std::remove_cv_t<T>, unsigned char>
     || std::same_as<std::remove_cv_t<T>, std::byte>);

template<class Ch, class Tr = char_traits<Ch>, class Allocator = allocator<Ch>> class basic_string {
    static_assert(is_same_v<typename Tr::char_type, Ch>);
    static_assert(is_same_v<typename Allocator::value_type, Ch>);
    static_assert(
        is_trivially_constructible_v<Ch> && is_trivially_copyable_v<Ch> && is_standard_layout_v<Ch>,
        "string: char_type must be trivial"
    );

    using Atr                                = allocator_traits<Allocator>;
    static constexpr bool alloc_always_equal = Atr::is_always_equal::value;
    static constexpr bool pocca              = Atr::propagate_on_container_copy_assignment::value;
    static constexpr bool pocma              = Atr::propagate_on_container_move_assignment::value;
    static constexpr bool pocs               = Atr::propagate_on_container_swap::value;

    using view_type = basic_string_view<Ch, Tr>;
    using __self    = type_identity_t<basic_string>;

    template<class R>
    static constexpr bool __str_sized_range =
        ranges::sized_range<R>
        || (!ranges::approximately_sized_range<R> && ranges::forward_range<R>);
    template<class R> requires __str_sized_range<R>
    static constexpr decltype(auto) __str_range_size(R&& r) {
        if constexpr (ranges::sized_range<R>)
            return ranges::size(r);
        else
            return ranges::distance(r);
    }

public:
    // types
    using traits_type     = Tr;
    using value_type      = Ch;
    using allocator_type  = Allocator;
    using size_type       = allocator_traits<Allocator>::size_type;
    using difference_type = allocator_traits<Allocator>::difference_type;
    using pointer         = allocator_traits<Allocator>::pointer;
    using const_pointer   = allocator_traits<Allocator>::const_pointer;
    using reference       = value_type&;
    using const_reference = value_type const&;

    using iterator                  = Ch*;        // see [container.requirements]
    using const_iterator            = Ch const*;  // see [container.requirements]
    using reverse_iterator          = std::reverse_iterator<iterator>;
    using const_reverse_iterator    = std::reverse_iterator<const_iterator>;
    static constexpr size_type npos = size_type(-1);

    // [string.cons], construct/copy/destroy
    constexpr basic_string() noexcept(noexcept(Allocator())): basic_string(Allocator()) {}
    constexpr explicit basic_string(Allocator const& a) noexcept: alloc_(a) {
        __set_short_size(0);
        __set_short_null();
    }

    constexpr basic_string(basic_string const& str)
        : basic_string(str, Atr::select_on_container_copy_construction(str.alloc_)) {}

    constexpr basic_string(basic_string&& str) noexcept: alloc_(std::move(str.alloc_)) {
        if (str.__is_short()) {
            Tr::copy(__short_data(), str.__short_data(), str.__short_size() + 1);
            __set_short_size(str.__short_size());
        } else {
            __move_long(std::move(str));
        }
    }

    constexpr basic_string(basic_string const& str, size_type pos, Allocator const& a = Allocator())
        : basic_string(str, pos, npos, a) {}

    constexpr basic_string(
        basic_string const& str, size_type pos, size_type n, Allocator const& a = Allocator()
    )
        : alloc_(a) {
        if (pos > str.size()) [[unlikely]]
            _THROW(out_of_range("string"));
        auto len = ranges::min(n, str.size() - pos);

        __ctor_resize(len);
        Tr::copy(data(), str.data() + pos, len);
        __set_null();
    }

    constexpr basic_string(basic_string&& str, size_type pos, Allocator const& a = Allocator())
        : basic_string(str, pos, npos, a) {}
    constexpr basic_string(
        basic_string&& str, size_type pos, size_type n, Allocator const& a = Allocator()
    )
        : alloc_(a) {
        if (pos > str.size()) [[unlikely]]
            _THROW(out_of_range("string"));
        auto len = ranges::min(n, str.size() - pos);

        if (len <= short_capacity) {
            __set_short_size(len);
            Tr::copy(__short_data(), str.data() + pos, len);
            __set_short_null();
            return;
        }

        if (alloc_always_equal || str.alloc_ == alloc_) {
            // Steal
            __move_long(std::move(str));
            Tr::move(__long_data(), __long_data() + pos, len);  // Trailing null
            __set_long_size(len);
        } else {
            __ctor_resize(len);
            Tr::copy(__long_data(), str.__long_data() + pos, len);
        }
        __set_long_null();
    }

    template<class T> requires is_convertible_v<T const&, view_type>
    constexpr basic_string(T const& t, size_type pos, size_type n, Allocator const& a = Allocator())
        : basic_string(view_type(t).substr(pos, n), a) {}

    template<class T> requires is_convertible_v<T const&, view_type>
    constexpr explicit basic_string(T const& t, Allocator const& a = Allocator()): alloc_(a) {
        view_type sv = t;
        __ctor_resize(sv.size());
        Tr::copy(data(), sv.data(), sv.size());
        __set_null();
    }

    constexpr basic_string(Ch const* s, size_type n, Allocator const& a = Allocator()): alloc_(a) {
        __ctor_resize(n);
        Tr::copy(data(), s, n);
        __set_null();
    }

    constexpr basic_string(Ch const* s, Allocator const& a = Allocator())
        requires __simple_allocator<Allocator>
        : basic_string(s, Tr::length(s), a) {}

    basic_string(nullptr_t) = delete;
    constexpr basic_string(size_type n, Ch c, Allocator const& a = Allocator())
        requires __simple_allocator<Allocator>
        : alloc_(a) {
        __ctor_resize(n);
        Tr::assign(data(), n, c);
        __set_null();
    }

    template<__detail::__LegacyInputIterator InputIterator>
    constexpr basic_string(InputIterator begin, InputIterator end, Allocator const& a = Allocator())
        : basic_string(from_range, ranges::subrange(std::move(begin), std::move(end)), a) {}

    template<ranges::__detail::container_compatible_range<Ch> R>
    constexpr basic_string(from_range_t, R&& rg, Allocator const& a = Allocator()): alloc_(a) {
        size_t est = 0;
        if constexpr (ranges::approximately_sized_range<R>)
            est = ranges::reserve_hint(rg);
        else if constexpr (ranges::sized_range<R> || ranges::forward_range<R>)
            est = ranges::distance(rg);

        __ctor_resize(est);

        Ch* ptr  = data();
        Ch* pend = data() + capacity();
        auto beg = ranges::begin(rg);
        auto end = ranges::end(rg);
        for (; beg != end && ptr != pend; ++beg, ++ptr) { Tr::assign(*ptr, *beg); }

        __set_size(ptr - data());
        __set_null();

        for (; beg != end; ++beg) push_back(*beg);
    }

    constexpr basic_string(initializer_list<Ch> il, Allocator const& a = Allocator())
        : basic_string(from_range, il, a) {}

    constexpr basic_string(basic_string const& o, Allocator const& a): alloc_(a) {
        __ctor_resize(o.size());
        Tr::copy(data(), o.data(), o.size() + 1);  // Null
    }
    constexpr basic_string(basic_string&& o, Allocator const& a): alloc_(a) {
        if (o.__is_short()) {
            Tr::copy(__short_data(), o.__short_data(), o.__short_size() + 1);
            __set_short_size(o.__short_size());
            return;
        }

        if (alloc_always_equal || o.alloc_ == alloc_) {
            __move_long(std::move(o));
        } else {
            __ctor_resize(o.__long_size());
            Tr::copy(__long_data(), o.__long_data(), o.__long_size() + 1);
        }
    }

    constexpr ~basic_string() {
        if (!__is_short()) {
            assert(store.long_.ptr_);
            __deallocate_long(0);
        }
    }

    constexpr basic_string& operator=(basic_string const& str) {
        if (this == &str) return *this;
        bool can_reuse = !pocca || alloc_always_equal || alloc_ == str.alloc_;

        if (str.size() <= short_capacity && (__is_short() || !can_reuse)) {
            if (!__is_short()) __deallocate_long(0);
            Tr::copy(__short_data(), str.data(), str.size() + 1);
            __set_short_size(str.size());
        } else if (can_reuse && str.size() <= capacity()) {
            // Can reuse current alloc
            Tr::copy(data(), str.data(), str.size() + 1);
            __set_size(str.size());
        } else {
            // Realloc
            basic_string tmp(str, pocca ? str.alloc_ : alloc_);

            __move_long(std::move(tmp));
        }

        if constexpr (pocca) alloc_ = str.alloc_;
        return *this;
    }

    constexpr basic_string& operator=(basic_string&& o) noexcept(pocma || alloc_always_equal) {
        if (this == &o) return *this;
        auto can_steal = pocma || alloc_always_equal || alloc_ == o.alloc_;
        auto can_reuse = !pocma || alloc_always_equal || alloc_ == o.alloc_;

        if (can_steal && !o.__is_short()) {
            // Always steal when possible
            __move_long(std::move(o));
        } else if (o.size() <= short_capacity && (__is_short() || !can_reuse)) {
            if (!__is_short()) __deallocate_long(0);
            Tr::copy(__short_data(), o.data(), o.size() + 1);
            __set_short_size(o.size());
        } else if (can_reuse && o.size() <= capacity()) {
            Tr::copy(data(), o.data(), o.size() + 1);
            __set_size(o.size());
        } else {
            // Need allocation
            assert(o.size() > short_capacity);
            basic_string tmp(std::move(o), pocma ? o.alloc_ : alloc_);
            __move_long(std::move(tmp));
        }
        if constexpr (pocma) alloc_ = std::move(o.alloc_);
        return *this;
    }

    template<class T> requires is_convertible_v<T const&, view_type>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    operator=(T const& t) {
        view_type sv = t;
        return assign(sv);
    }

    constexpr basic_string& operator=(Ch const* s) { return assign(s); }
    basic_string& operator=(nullptr_t) = delete;
    constexpr basic_string& operator=(Ch c) { return assign(1, c); }
    constexpr basic_string& operator=(initializer_list<Ch> il) { return assign(il); }

    // [string.iterators], iterators
    constexpr iterator begin() noexcept { return iterator(data()); }
    constexpr const_iterator begin() const noexcept { return const_iterator(data()); }
    constexpr iterator end() noexcept { return iterator(data() + size()); }
    constexpr const_iterator end() const noexcept { return const_iterator(data() + size()); }

    constexpr reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
    constexpr const_reverse_iterator rbegin() const noexcept {
        return const_reverse_iterator(end());
    }
    constexpr reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
    constexpr const_reverse_iterator rend() const noexcept {
        return const_reverse_iterator(begin());
    }

    constexpr const_iterator cbegin() const noexcept { return begin(); }
    constexpr const_iterator cend() const noexcept { return end(); }
    constexpr const_reverse_iterator crbegin() const noexcept { return rbegin(); }
    constexpr const_reverse_iterator crend() const noexcept { return rend(); }

    // [string.capacity], capacity
    constexpr size_type size() const noexcept {
        return __is_short() ? __short_size() : __long_size();
    }
    constexpr size_type length() const noexcept { return size(); }
    constexpr size_type max_size() const noexcept { return Atr::max_size(alloc_) / 2 - 1; }

    constexpr void resize(size_type n, Ch c) {
        if (n <= size()) {
            __set_size(n);
            __set_null();
            return;
        }

        if (n > capacity()) reserve(n);

        Tr::assign(data() + size(), n, c);
        __set_size(n);
        __set_null();
    }
    constexpr void resize(size_type n) { resize(n, Ch(0)); }

    template<class Operation> constexpr void resize_and_overwrite(size_type n, Operation op) {
        static_assert(integral<invoke_result_t<Operation, Ch*, size_type>>);

        reserve(n);
        auto r = std::move(op)(data(), n);
        assert(std::cmp_less_equal(r, n));
        __set_size(size_type(r));
        __set_null();
    }

    constexpr size_type capacity() const noexcept {
        return __is_short() ? __short_cap() : __long_cap();
    }

    constexpr void reserve(size_type res_arg) {
        if (res_arg <= capacity()) return;

        basic_string tmp(alloc_);
        tmp.__ctor_reserve(res_arg);
        Tr::copy(tmp.__long_data(), data(), size() + 1);
        tmp.__set_long_size(size());

        __move_long(std::move(tmp));
    }
    constexpr void shrink_to_fit() {
        if (size() == capacity() || __is_short()) return;

        basic_string tmp(alloc_);
        tmp.reserve(size());
        if (tmp.capacity() >= capacity()) return;

        Tr::copy(tmp.data(), data(), size() + 1);
        tmp.__set_size(size());

        if (tmp.__is_short()) {
            __deallocate_long(tmp.__short_size());
            Tr::copy(__short_data(), tmp.__short_data(), tmp.__short_size() + 1);
        } else {
            __move_long(std::move(tmp));
        }
    }
    constexpr void clear() noexcept {
        __set_size(0);
        __set_null();
    }
    constexpr bool empty() const noexcept { return size() == 0; }

    // [string.access], element access
    constexpr const_reference operator[](size_type pos) const {
        assert(pos <= size());
        return data()[pos];
    }
    constexpr reference operator[](size_type pos) {
        assert(pos <= size());
        return data()[pos];
    }

#ifdef _STL_HAS_EH
    constexpr const_reference at(size_type n) const {
        if (n > size()) throw std::out_of_range("string::at");
        return data()[n];
    }
    constexpr reference at(size_type n) {
        if (n > size()) throw std::out_of_range("string::at");
        return data()[n];
    }
#else
    constexpr const_reference at(size_type n) const = _DELETE_NO_EXCEPTIONS;
    constexpr reference at(size_type n)             = _DELETE_NO_EXCEPTIONS;
#endif

    constexpr const_reference front() const {
        assert(!empty());
        return data()[0];
    }
    constexpr reference front() {
        assert(!empty());
        return data()[0];
    }
    constexpr const_reference back() const {
        assert(!empty());
        return data()[size() - 1];
    }
    constexpr reference back() {
        assert(!empty());
        return data()[size() - 1];
    }

    // [string.modifiers], modifiers
    constexpr basic_string& operator+=(basic_string const& str) { return append(str); }
    template<class T> requires is_convertible_v<T const&, basic_string_view<Ch, Tr>>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    operator+=(T const& t) {
        view_type sv = t;
        return append(sv);
    }

    constexpr basic_string& operator+=(Ch const* s) { return append(s); }
    constexpr basic_string& operator+=(Ch c) {
        push_back(c);
        return *this;
    }
    constexpr basic_string& operator+=(initializer_list<Ch> il) { return append(il); }

    constexpr basic_string& append(basic_string const& str) {
        return __append_contiguous(view_type(str));
    }
    constexpr basic_string& append(basic_string const& str, size_type pos, size_type n = npos) {
        return __append_contiguous(str.subview(pos, n));
    }
    template<class T> requires is_convertible_v<T const&, basic_string_view<Ch, Tr>>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    append(T const& t) {
        return __append_contiguous(view_type(t));
    }
    template<class T> requires is_convertible_v<T const&, basic_string_view<Ch, Tr>>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    append(T const& t, size_type pos, size_type n = npos) {
        return __append_contiguous(view_type(t).substr(pos, n));
    }
    constexpr basic_string& append(Ch const* s, size_type n) {
        return __append_contiguous(view_type(s, n));
    }
    constexpr basic_string& append(Ch const* s) { return __append_contiguous(view_type(s)); }
    constexpr basic_string& append(Ch const* s, size_type pos, size_type n) {
        return __append_contiguous(view_type(s).substr(pos, n));
    }
    constexpr basic_string& append(size_type n, Ch c) {
        return __append_impl(n, [n, c](Ch* tgt) { Tr::assign(tgt, n, c); });
    }
    template<__detail::__LegacyInputIterator InputIterator>
    constexpr basic_string& append(InputIterator first, InputIterator last) {
        return append_range(ranges::subrange(std::move(first), std::move(last)));
    }
    constexpr basic_string& append(initializer_list<Ch> il) {
        return __append_contiguous(view_type(il.data(), il.size()));
    }

    template<ranges::__detail::container_compatible_range<Ch> R>
    constexpr basic_string& append_range(R&& rg) {

        if constexpr (__str_sized_range<R>) {
            if constexpr (
                ranges::contiguous_range<R> && same_as<remove_cv_t<ranges::range_value_t<R>>, Ch>
            ) {
                return __append_contiguous(view_type(ranges::data(rg), __str_range_size(rg)));
            } else {
                __append_impl(__str_range_size(rg), [&](Ch* tgt) {
                    for (auto&& e: rg) Tr::assign(*tgt++, static_cast<Ch>(FWD(e)));
                });
            }
        } else if constexpr (ranges::approximately_sized_range<R>) {
            experimental::scope_exit _([&] { __set_null(); });

            size_type est = ranges::reserve_hint(rg);
            auto beg      = ranges::begin(rg);
            auto end      = ranges::end(rg);

            if (est + size() <= capacity()) {
                Ch* tgt = data() + size();
                for (; beg != end && tgt != data() + capacity(); ++beg)
                    Tr::assign(*tgt++, static_cast<Ch>(*beg));
                __set_size(tgt - data());

                if (beg != end) {
                    __self tmp(
                        from_range, ranges::subrange(std::move(beg), std::move(end)), alloc_
                    );
                    return append(tmp);
                }
            } else {
                __self tmp(alloc_);
                tmp.__ctor_reserve(__calculate_growth(size() + est));
                Ch* tgt = tmp.data() + size();

                Tr::copy(tmp.data(), data(), size());
                for (; beg != end && tgt != tmp.data() + tmp.capacity(); ++beg)
                    Tr::assign(*tgt++, static_cast<Ch>(*beg));

                tmp.__set_size(tgt - tmp.data());

                if (beg != end) {
                    __self tmp2(
                        from_range, ranges::subrange(std::move(beg), std::move(end)), alloc_
                    );
                    __move_long(std::move(tmp));
                    return append(tmp2);
                } else {
                    __move_long(std::move(tmp));
                }
            }
        } else {
            __self tmp(from_range, rg, alloc_);
            return append(tmp);
        }
        return *this;
    }

    constexpr basic_string& __append_contiguous(view_type sv) {
        return __append_impl(sv.size(), [&](Ch* tgt) { Tr::copy(tgt, sv.data(), sv.size()); });
    }

    constexpr basic_string& __append_impl(size_t n, auto&& filler) {
        experimental::scope_exit _([&] { __set_null(); });  // Even if filler throws
        auto const sz = size();

        if (sz + n <= capacity()) {
            filler(data() + sz);
            __set_size(sz + n);

        } else {
            __self tmp(alloc_);
            tmp.__ctor_reserve(__calculate_growth(sz + n));
            Tr::copy(tmp.data(), data(), sz);
            filler(tmp.data() + sz);
            tmp.__set_size(sz + n);

            __move_long(std::move(tmp));
        }
        return *this;
    }

    constexpr void push_back(Ch c) {
        if (size() == capacity()) { reserve(__calculate_growth(size() + 1)); }

        Tr::assign(data()[size()], c);
        __set_size(size() + 1);
        __set_null();
    }

    constexpr basic_string& assign(basic_string const& str) { return *this = str; }
    constexpr basic_string& assign(basic_string&& str) noexcept(
        allocator_traits<Allocator>::propagate_on_container_move_assignment::value
        || allocator_traits<Allocator>::is_always_equal::value
    ) {
        return *this = std::move(str);
    }

    constexpr basic_string& assign(basic_string const& str, size_type pos, size_type n = npos) {
        return __assign_contiguous(view_type(str).subview(pos, n));
    }
    template<class T> requires is_convertible_v<T const&, basic_string_view<Ch, Tr>>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    assign(T const& t) {
        return __assign_contiguous(view_type(t));
    }
    template<class T> requires is_convertible_v<T const&, basic_string_view<Ch, Tr>>
                            && (!is_convertible_v<T const&, Ch const*>)constexpr basic_string&
    assign(T const& t, size_type pos, size_type n = npos) {
        return __assign_contiguous(view_type(t).substr(pos, n));
    }
    constexpr basic_string& assign(Ch const* s, size_type n) {
        return __assign_contiguous(view_type(s, n));
    }
    constexpr basic_string& assign(Ch const* s) { return __assign_contiguous(view_type(s)); }
    constexpr basic_string& assign(Ch const* s, size_type pos, size_type n) {
        return __assign_contiguous(view_type(s).substr(pos, n));
    }
    constexpr basic_string& assign(size_type n, Ch c) {
        if (n <= capacity()) {
            Tr::assign(data(), n, c);
            __set_size(n);
            __set_null();
        } else {
            __self tmp(n, c, alloc_);
            __move_long(std::move(tmp));
        }
        return *this;
    }
    template<__detail::__LegacyInputIterator InputIterator>
    constexpr basic_string& assign(InputIterator first, InputIterator last) {
        return assign_range(ranges::subrange(std::move(first), std::move(last)));
    }
    constexpr basic_string& assign(initializer_list<Ch> il) {
        return __assign_contiguous(view_type(il.data(), il.size()));
    }

    template<ranges::__detail::container_compatible_range<Ch> R>
    constexpr basic_string& assign_range(R&& rg) {
        constexpr bool is_exact =
            ranges::sized_range<R>
            || (!ranges::approximately_sized_range<R> && ranges::forward_range<R>);

        size_t est = 0;
        if constexpr (ranges::approximately_sized_range<R>)
            est = ranges::reserve_hint(rg);
        else if constexpr (ranges::forward_range<R>)
            est = ranges::distance(rg);

        if constexpr (ranges::contiguous_range<R> && is_exact) {
            return __assign_contiguous(view_type(ranges::data(rg), est));
        } else {
            __self tmp(from_range, rg, alloc_);
            if (tmp.size() <= capacity()) {
                Tr::copy(data(), tmp.data(), tmp.size() + 1);
                __set_size(tmp.size());
            } else {
                __move_long(std::move(tmp));
            }
            return *this;
        }
    }

    constexpr basic_string& __assign_contiguous(view_type sv) {
        if (sv.size() <= capacity()) {
