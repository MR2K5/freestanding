template<class charT, class traits, class Allocator>
constexpr void swap(
    basic_string<charT, traits, Allocator>& lhs, basic_string<charT, traits, Allocator>& rhs
) noexcept(noexcept(lhs.swap(rhs))) {
    lhs.swap(rhs);
}

template<class charT, class traits, class Allocator, class U = charT>
constexpr basic_string<charT, traits, Allocator>::size_type
erase(basic_string<charT, traits, Allocator>& c, U const& value) {
    auto [b, e] = ranges::remove(c, value);
    c.erase(b, e);
    return static_cast<basic_string<charT, traits, Allocator>::size_type>(e - b);
}

template<class charT, class traits, class Allocator, class Predicate>
constexpr basic_string<charT, traits, Allocator>::size_type
erase_if(basic_string<charT, traits, Allocator>& c, Predicate pred) {
    auto [b, e] = ranges::remove_if(c, std::ref(pred));
    c.erase(b, e);
    return static_cast<basic_string<charT, traits, Allocator>::size_type>(e - b);
}

template<class A> struct hash<basic_string<char, char_traits<char>, A>> {
    static constexpr size_t operator()(basic_string<char, char_traits<char>, A> const& s) noexcept {
        return __detail::hash_bytes(s.data(), s.size());
    }
};

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator> const& lhs,
    basic_string<charT, traits, Allocator> const& rhs
) {
    return lhs + rhs.subview();
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator>&& lhs, basic_string<charT, traits, Allocator> const& rhs
) {
    lhs.append(rhs);
    return lhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator> const& lhs, basic_string<charT, traits, Allocator>&& rhs
) {
    rhs.insert(0, lhs);
    return rhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator>&& lhs, basic_string<charT, traits, Allocator>&& rhs
) {
    auto const total = lhs.size() + rhs.size();

    if (lhs.capacity() >= total) {
        lhs.append(rhs);
        return lhs;
    } else if (
        rhs.capacity() >= total
        && (allocator_traits<Allocator>::is_always_equal::value
            || lhs.get_allocator() == rhs.get_allocator())
    ) {
        rhs.insert(0, lhs);
        return rhs;
    } else {
        lhs.append(rhs);
        return lhs;
    }
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(charT const* lhs, basic_string<charT, traits, Allocator> const& rhs) {
    return basic_string_view<charT, traits>(lhs) + rhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(charT const* lhs, basic_string<charT, traits, Allocator>&& rhs) {
    rhs.insert(0, lhs);
    return rhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(charT lhs, basic_string<charT, traits, Allocator> const& rhs) {
    return basic_string_view<charT, traits>(std::addressof(lhs), 1) + rhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(charT lhs, basic_string<charT, traits, Allocator>&& rhs) {
    rhs.insert(0, 1, lhs);
    return rhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(basic_string<charT, traits, Allocator> const& lhs, charT const* rhs) {
    return lhs + basic_string_view<charT, traits>(rhs);
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(basic_string<charT, traits, Allocator>&& lhs, charT const* rhs) {
    lhs.append(rhs);
    return lhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(basic_string<charT, traits, Allocator> const& lhs, charT rhs) {
    return lhs + basic_string_view<charT, traits>(std::addressof(rhs), 1);
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator>
operator+(basic_string<charT, traits, Allocator>&& lhs, charT rhs) {
    lhs.push_back(rhs);
    return lhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator> const& lhs,
    type_identity_t<basic_string_view<charT, traits>> rhs
) {
    basic_string<charT, traits, Allocator> r(
        allocator_traits<Allocator>::select_on_container_copy_construction(lhs.get_allocator())
    );
    r.reserve(lhs.size() + rhs.size());
    r.append(lhs);
    r.append(rhs);
    return r;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    basic_string<charT, traits, Allocator>&& lhs,
    type_identity_t<basic_string_view<charT, traits>> rhs
) {
    lhs.append(rhs);
    return lhs;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    type_identity_t<basic_string_view<charT, traits>> lhs,
    basic_string<charT, traits, Allocator> const& rhs
) {
    basic_string<charT, traits, Allocator> r(
        allocator_traits<Allocator>::select_on_container_copy_construction(rhs.get_allocator())
    );
    r.reserve(lhs.size() + rhs.size());
    r.append(lhs);
    r.append(rhs);
    return r;
}

template<class charT, class traits, class Allocator>
constexpr basic_string<charT, traits, Allocator> operator+(
    type_identity_t<basic_string_view<charT, traits>> lhs,
    basic_string<charT, traits, Allocator>&& rhs
) {
    rhs.insert(0, lhs);
    return rhs;
}

template<class charT, class traits, class Allocator>
constexpr bool operator==(
    basic_string<charT, traits, Allocator> const& lhs,
    basic_string<charT, traits, Allocator> const& rhs
) noexcept {
    return lhs.subview() == rhs.subview();
}

template<class charT, class traits, class Allocator>
constexpr bool operator==(basic_string<charT, traits, Allocator> const& lhs, charT const* rhs) {
    return lhs.subview() == rhs;
}

template<class charT, class traits, class Allocator>
constexpr __sv_comp_cat<traits> operator<=>(
    basic_string<charT, traits, Allocator> const& lhs,
    basic_string<charT, traits, Allocator> const& rhs
) noexcept {
    return lhs.subview() <=> rhs.subview();
}

template<class charT, class traits, class Allocator>
constexpr __sv_comp_cat<traits>
operator<=>(basic_string<charT, traits, Allocator> const& lhs, charT const* rhs) {
    return lhs.subview() <=> rhs;
}

