    constexpr void swap(basic_string& o) noexcept(
        allocator_traits<Allocator>::propagate_on_container_swap::value
        || allocator_traits<Allocator>::is_always_equal::value
    ) {
        if (__is_short() && o.__is_short()) {
            ranges::swap_ranges(store.short_, o.store.short_);
        } else if (!__is_short() && !o.__is_short()) {
            swap(store.long_, o.store.long_);
        } else {
            auto& s = __is_short() ? *this : o;
            auto& l = !__is_short() ? *this : o;

            Ch tmp[short_capacity + 1];
            auto sz = s.__short_size();
            Tr::copy(tmp, s.__short_data(), sz + 1);
            s.__move_long(std::move(tmp));
            Tr::copy(l.__short_data(), tmp, sz + 1);
            l.__set_short_size(sz);
        }

        if constexpr (pocs) swap(alloc_, o.alloc_);
    }

