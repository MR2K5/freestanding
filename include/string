                      || (__is_aliasing_pointer(sv.data())
                          && ranges::greater_equal()(sv.data() + sv.size(), data() + pos)));

        // Aliasing is only hurtful if sv overlaps the shifted part
        return __insert_impl(pos, sv.size(), alias, [&sv](Ch* tgt) {
            Tr::copy(tgt, sv.data(), sv.size());
