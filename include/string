    template<ranges::__detail::container_compatible_range<Ch> R>
    constexpr iterator insert_range(const_iterator p, R&& rg) {
        size_type pos = p - cbegin();

        if constexpr (ranges::sized_range<R>) {
            experimental::scope_exit _([&] {
                __set_null();
            });  // In case an iterator throws, keep the basic guarantee
            // TODO can there be uninitialized elementsif iter throws?

            if constexpr (
                ranges::contiguous_range<R> && same_as<remove_cv_t<ranges::range_value_t<R>>, Ch>
            ) {
                __insert_contiguous(pos, view_type(ranges::data(rg), ranges::size(rg)), false);
            } else {
                __insert_impl(
                    pos, ranges::size(rg),
                    !ranges::contiguous_range<R> || __may_alias_v<ranges::range_value_t<R>, Ch>,
                    [&](Ch* tgt) {
                        for (auto&& e: rg) Tr::assign(*tgt++, static_cast<Ch>(FWD(e)));
                    }
                );
            }
        } else {
            auto old_sz = size();
            append_range(rg);
            ranges::rotate(data() + pos, data() + old_sz, data() + size());
        }
        return begin() + pos;
    }

    constexpr basic_string& __insert_impl(size_type pos, size_type n, bool alias, auto&& filler) {
        if (pos > size()) [[unlikely]]
            _THROW(out_of_range("string::insert"));

        if (n == 0) return *this;

        if (size() + n > capacity()) {
            // Grows anyway:
            __self tmp(alloc_);
            tmp.reserve(__calculate_growth(size() + n));
            Tr::copy(tmp.data(), data(), pos);
            filler(tmp.data() + pos);
            Tr::copy(tmp.data() + pos + n, data() + pos, size() - pos + 1);

            tmp.__set_size(size() + n);
            __move_long(std::move(tmp));
            return *this;
        }

        if (alias) {
            filler(data() + size() + 1);
            ranges::rotate(data() + pos, data() + size() + 1, data() + size() + n + 1);
            __set_size(size() + n);
        } else {
            // Insert
            auto const sz = size();
            Tr::move(data() + pos + n, data() + pos, sz - pos + 1);
            filler(data() + pos);
            __set_size(sz + n);
        }
        return *this;
    }

