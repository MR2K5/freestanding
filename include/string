    template<ranges::__detail::container_compatible_range<Ch> R>
    constexpr basic_string& replace_with_range(const_iterator i1, const_iterator i2, R&& rg) {
        size_type pos  = i1 - cbegin();
        size_type rlen = i2 - i1;

        if constexpr (ranges::sized_range<R>) {
            experimental::scope_exit _([&] { __set_null(); });  // For throwing iter

            // must assume aliasing unless we can prove otherwise
            if constexpr (
                ranges::contiguous_range<R> && same_as<remove_cv_t<ranges::range_value_t<R>>, Ch>
            ) {
                return __replace_contiguous(
                    pos, rlen, view_type(ranges::data(rg), ranges::size(rg)), false
                );
            } else {
                return __replace_impl(
                    pos, rlen, ranges::size(rg),
                    !ranges::contiguous_range<R> || __may_alias_v<ranges::range_value_t<R>, Ch>,
                    [&](Ch* tgt) {
                        for (auto&& elem: rg) Tr::assign(*tgt++, static_cast<Ch>(FWD(elem)));
                    },
                    false
                );
            }

        } else {
            auto old_sz = size();
            append_range(FWD(rg));
            auto nlen = size() - old_sz;
            Tr::move(data() + pos, data() + pos + rlen, old_sz + nlen - pos - rlen + 1);
            ranges::rotate(data() + pos, data() + old_sz - rlen, data() + old_sz + nlen - rlen);

            __set_size(size() - rlen);
            // __set_null(); // Tr::move handles and rotate does not change size
        }
        return *this;
    }

    constexpr basic_string&
    __replace_contiguous(size_type pos, size_type rlen, view_type sv, bool noalias_override) {
        bool alias = !noalias_override && sv.size() <= size()
                  && (is_constant_evaluated()
                      || (__is_aliasing_pointer(sv.data())
                          && ranges::greater_equal()(sv.data() + sv.size(), data() + pos)));
        return __replace_impl(
            pos, rlen, sv.size(), alias,
            [=, this](Ch* tgt) {
                Ch const* src = sv.data();
                Tr::move(tgt, src, sv.size());
            },
            true
        );
    }

    constexpr basic_string& __replace_impl(
        size_type pos, size_type rlen, size_type nlen, bool alias, auto&& filler,
        bool filler_uses_move
    ) {
        if (pos > size()) [[unlikely]]
            _THROW(std::out_of_range("string::replace"));
        rlen                 = ranges::min(rlen, size() - pos);
        size_type total_size = size() - rlen + nlen;

        // In aliasing case we must append at end and then move. If no aliasing we can directly
        // write the new part
        if (total_size <= capacity()) {
            if (!alias) {
                // Disjoint: move suffix, then fill
                Tr::move(data() + pos + nlen, data() + pos + rlen, size() - pos - rlen + 1);
                filler(data() + pos);

                __set_size(total_size);
                return *this;
            } else if (filler_uses_move && rlen >= nlen) {
                // Shrinking / Equal (Aliased):
                // Fill into hole FIRST (does not touch suffix), then slide suffix left
                // filler must use Tr::move
                filler(data() + pos);
                Tr::move(data() + pos + nlen, data() + pos + rlen, size() - pos - rlen + 1);

                __set_size(total_size);
                return *this;
            } else if (size() + nlen <= capacity()) {
                // Growing (Aliased):
                // Use slack past null terminator if it fits, else rebase pointer
                filler(data() + size() + 1);
                auto sz = size();
                Tr::move(data() + pos, data() + pos + rlen, sz + nlen - pos - rlen + 1);
                ranges::rotate(data() + pos, data() + sz - rlen + 1, data() + sz + nlen - rlen + 1);
                __set_size(total_size);
                return *this;
            }
        }

        // Need allocation
        __self tmp(alloc_);
        tmp.__ctor_reserve(__calculate_growth(total_size));
        Tr::copy(tmp.data(), data(), pos);
        filler(tmp.data() + pos);
        Tr::copy(tmp.data() + pos + nlen, data() + pos + rlen, size() - pos - rlen + 1);
        tmp.__set_size(total_size);

        if (tmp.__is_short()) {
            Tr::copy(data(), tmp.__short_data(), tmp.__short_size() + 1);
            __set_size(tmp.__short_size());
        } else {
            __move_long(std::move(tmp));
        }

        return *this;
    }

