#pragma once

#include <string.h>

namespace std {

inline void* memcpy(void* __restrict s1, void const* __restrict s2, size_t n) noexcept {
    return __builtin_memcpy(s1, s2, n);
}
inline void* memccpy(void* __restrict s1, void const* __restrict s2, int c, size_t n) noexcept {
    return ::memccpy(s1, s2, c, n);
}
inline void* memmove(void* s1, void const* s2, size_t n) noexcept {
    return __builtin_memmove(s1, s2, n);
}
inline char* strcpy(char* __restrict s1, char const* __restrict s2) noexcept {
    return __builtin_strcpy(s1, s2);
}
inline char* strncpy(char* __restrict s1, char const* __restrict s2, size_t n) noexcept {
    return __builtin_strncpy(s1, s2, n);
}
