#pragma once

#include <cstdint>

namespace std {

struct source_location {
private:
    struct __impl;

public:
    // source location construction
    static consteval source_location
    current(__impl const* p = __builtin_source_location()) noexcept {
        source_location tmp;
        tmp.impl = p;
        return tmp;
    }
    constexpr source_location() noexcept = default;

    constexpr source_location(source_location const&) noexcept            = default;
    constexpr source_location& operator=(source_location const&) noexcept = default;

    // source location field access
    constexpr uint_least32_t line() const noexcept { return impl ? impl->_M_line : 0; }
    constexpr uint_least32_t column() const noexcept { return impl ? impl->_M_column : 0; }
    constexpr char const* file_name() const noexcept { return impl ? impl->_M_file_name : ""; }
    constexpr char const* function_name() const noexcept {
        return impl ? impl->_M_function_name : "";
    }

private:
    struct __impl {
        char const* _M_file_name;
        char const* _M_function_name;
        uint_least32_t _M_line;
        uint_least32_t _M_column;
    };
    __impl const* impl = nullptr;
};

}  // namespace std
