#pragma once

#include <exception>

#include <__type_info/type_info.hpp>

namespace std {

class bad_cast: public exception {
public:
    ~bad_cast();
    bad_cast()                           = default;
    bad_cast(bad_cast const&)            = default;
    bad_cast& operator=(bad_cast const&) = default;
    char const* what() const noexcept override { return "bad_cast"; }
};

class bad_typeid: public exception {
public:
    ~bad_typeid();
    bad_typeid()                             = default;
    bad_typeid(bad_typeid const&)            = default;
    bad_typeid& operator=(bad_typeid const&) = default;
    char const* what() const noexcept override { return "bad_typeid"; }
};

}  // namespace std
