            return r;
        } else {
            return __atomic_fetch_min(ptr_, v, __get_order(o));
        }
    }

    constexpr void store_add(ptrdiff_t v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __pointer) {
        fetch_add(v, o);
    }
    constexpr void store_sub(ptrdiff_t v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __pointer) {
        fetch_sub(v, o);
    }
    constexpr void store_max(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __pointer) {
        fetch_max(v, o);
    }
    constexpr void store_min(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __pointer) {
        fetch_min(v, o);
    }

    constexpr value_type operator++(int) const noexcept requires(!__isconst && __pointer) {
        return fetch_add(1);
    }
    constexpr value_type operator--(int) const noexcept requires(!__isconst && __pointer) {
        return fetch_sub(1);
    }
    constexpr value_type operator++() const noexcept requires(!__isconst && __pointer) {
        return fetch_add(1) + 1;
    }
    constexpr value_type operator--() const noexcept requires(!__isconst && __pointer) {
        return fetch_sub(1) - 1;
    }
    constexpr value_type operator+=(ptrdiff_t v) const noexcept requires(!__isconst && __pointer) {
        return fetch_add(v) + v;
    }
    constexpr value_type operator-=(ptrdiff_t v) const noexcept requires(!__isconst && __pointer) {
        return fetch_sub(v) - v;
    }

    // --- Specializations for Floating-Point Types [atomics.ref.float] ---

    constexpr value_type
    fetch_add(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        if consteval {
            auto r  = *ptr_;
            *ptr_  += v;
            return r;
        } else {
            value_type old_val = load(memory_order::relaxed);
            while (!compare_exchange_weak(old_val, old_val + v, o, memory_order::relaxed)) {}
            return old_val;
        }
    }

    constexpr value_type
    fetch_sub(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        if consteval {
            auto r  = *ptr_;
            *ptr_  -= v;
            return r;
        } else {
            value_type old_val = load(memory_order::relaxed);
            while (!compare_exchange_weak(old_val, old_val - v, o, memory_order::relaxed)) {}
            return old_val;
        }
    }

    constexpr value_type
    fetch_max(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        if consteval {
            auto r = *ptr_;
            *ptr_  = std::max(*ptr_, v);
            return r;
        } else {
            value_type old_val = load(memory_order::relaxed);
            while (!compare_exchange_weak(
                old_val,
                (__builtin_isnan(v) ? old_val
                                    : (__builtin_isnan(old_val) ? v : (old_val < v ? v : old_val))),
                o, memory_order::relaxed
            )) {}
            return old_val;
        }
    }

    constexpr value_type
    fetch_min(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        if consteval {
            auto r = *ptr_;
            *ptr_  = std::min(*ptr_, v);
            return r;
        } else {
            value_type old_val = load(memory_order::relaxed);
            while (!compare_exchange_weak(
                old_val,
                (__builtin_isnan(v) ? old_val
                                    : (__builtin_isnan(old_val) ? v : (v < old_val ? v : old_val))),
                o, memory_order::relaxed
            )) {}
            return old_val;
        }
    }

    constexpr value_type
    fetch_fmaximum(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        value_type old_val = load(memory_order::relaxed);
        while (!compare_exchange_weak(
            old_val,
            (__builtin_isnan(old_val) || __builtin_isnan(v)
                 ? (__builtin_isnan(old_val) ? old_val : v)
                 : (old_val < v ? v : old_val)),
            o, memory_order::relaxed
        )) {}
        return old_val;
    }

    constexpr value_type
    fetch_fminimum(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        value_type old_val = load(memory_order::relaxed);
        while (!compare_exchange_weak(
            old_val,
            (__builtin_isnan(old_val) || __builtin_isnan(v)
                 ? (__builtin_isnan(old_val) ? old_val : v)
                 : (v < old_val ? v : old_val)),
            o, memory_order::relaxed
        )) {}
        return old_val;
    }

    constexpr value_type
    fetch_fmaximum_num(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        return fetch_max(v, o);
    }

    constexpr value_type
    fetch_fminimum_num(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        return fetch_min(v, o);
    }

    constexpr void store_add(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_add(v, o);
    }
    constexpr void store_sub(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_sub(v, o);
    }
    constexpr void store_max(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_max(v, o);
    }
    constexpr void store_min(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_min(v, o);
    }
    constexpr void
    store_fmaximum(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_fmaximum(v, o);
    }
    constexpr void
    store_fminimum(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_fminimum(v, o);
    }
    constexpr void
    store_fmaximum_num(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_fmaximum_num(v, o);
    }
    constexpr void
    store_fminimum_num(value_type v, memory_order o = memory_order::seq_cst) const noexcept
        requires(!__isconst && __floating) {
        fetch_fminimum_num(v, o);
    }

    constexpr value_type operator+=(value_type v) const noexcept requires(!__isconst && __floating)
    {
        return fetch_add(v) + v;
    }
    constexpr value_type operator-=(value_type v) const noexcept requires(!__isconst && __floating)
    {
        return fetch_sub(v) - v;
    }
};

