// SFINAE / Concepts helper to inject difference_type for integral, float, and pointer
// specializations
template<class T> struct __atomic_ref_members {};

template<class T> requires(is_integral_v<remove_cv_t<T>> && !is_same_v<remove_cv_t<T>, bool>)
                       || is_floating_point_v<remove_cv_t<T>> struct __atomic_ref_members<T> {
    using difference_type = remove_cv_t<T>;
};

template<class T> requires is_pointer_v<remove_cv_t<T>> struct __atomic_ref_members<T> {
    using difference_type = ptrdiff_t;
};

template<class T> struct atomic_ref: __atomic_ref_members<T> {
    static_assert(
        is_trivially_copyable_v<T>, "std::atomic_ref<T> requires T to be trivially copyable."
    );

public:
    using value_type = remove_cv_t<T>;

    static constexpr size_t required_alignment =
        (sizeof(value_type) <= 16)
            ? std::max(alignof(value_type), std::bit_ceil(sizeof(value_type)))
            : alignof(value_type);

    static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(value_type), 0);

    static_assert(
        !is_volatile_v<T> || is_always_lock_free,
        "std::atomic_ref<volatile T> is ill-formed when operations are not always lock-free."
    );

private:
    static constexpr bool __isconst  = is_const_v<T>;
    static constexpr bool __use_n    = is_arithmetic_v<value_type> || is_pointer_v<value_type>;
    static constexpr bool __integral = is_integral_v<value_type> && !is_same_v<value_type, bool>;
    static constexpr bool __floating = is_floating_point_v<value_type>;
    static constexpr bool __pointer =
        is_pointer_v<value_type> && is_object_v<remove_pointer_t<value_type>>;

    T* ptr_;

public:
    // [atomics.ref.ops] Constructors and assignment
    constexpr explicit atomic_ref(T& obj) noexcept: ptr_(__builtin_addressof(obj)) {}
    explicit atomic_ref(T&&)                         = delete;
    constexpr atomic_ref(atomic_ref const&) noexcept = default;

    template<class U> requires is_same_v<remove_cv_t<U>, value_type> && is_convertible_v<U*, T*>
    constexpr atomic_ref(atomic_ref<U> const& ref) noexcept: ptr_(ref.address()) {}

    atomic_ref& operator=(atomic_ref const&) = delete;

    bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(value_type), ptr_); }

    constexpr __copy_cv_t<T, void>* address() const noexcept { return ptr_; }

    // --- General Operations ---

    constexpr void
    store(value_type desired, memory_order order = memory_order::seq_cst) const noexcept
        requires(!__isconst) {
        if consteval {
            *ptr_ = desired;
        } else {
            if constexpr (__use_n) {
                __atomic_store_n(ptr_, desired, __get_order(order));
            } else {
                __atomic_store(ptr_, &desired, __get_order(order));
            }
        }
    }

    constexpr value_type operator=(value_type desired) const noexcept requires(!__isconst) {
        store(desired);
        return desired;
    }

    constexpr value_type load(memory_order order = memory_order::seq_cst) const noexcept {
        if consteval {
            return *ptr_;
        } else {
            if constexpr (__use_n) {
                return __atomic_load_n(ptr_, __get_order(order));
            } else {
                value_type ret;
                __atomic_load(ptr_, &ret, __get_order(order));
                return ret;
            }
        }
    }

    constexpr operator value_type() const noexcept { return load(); }

    constexpr value_type
    exchange(value_type desired, memory_order order = memory_order::seq_cst) const noexcept
        requires(!__isconst) {
        if consteval {
            return std::exchange(*ptr_, desired);
        } else {
            if constexpr (__use_n) {
                return __atomic_exchange_n(ptr_, desired, __get_order(order));
            } else {
                value_type ret;
                __atomic_exchange(ptr_, &desired, &ret, __get_order(order));
                return ret;
            }
        }
    }

    constexpr bool compare_exchange_weak(
        value_type& expected, value_type desired, memory_order success, memory_order failure
    ) const noexcept requires(!__isconst) {
        if consteval {
            return compare_exchange_strong(expected, desired, success, failure);
        } else {
            if constexpr (__use_n) {
                return __atomic_compare_exchange_n(
                    ptr_, &expected, desired, true, __get_order(success), __get_order(failure)
                );
            } else {
                return __atomic_compare_exchange(
                    ptr_, &expected, &desired, true, __get_order(success), __get_order(failure)
                );
            }
        }
    }

    constexpr bool compare_exchange_strong(
        value_type& expected, value_type desired, memory_order success, memory_order failure
    ) const noexcept requires(!__isconst) {
        if consteval {
            if (__atomic_bitwise_eq(*ptr_, expected)) {
                *ptr_ = desired;
                return true;
            } else {
                expected = *ptr_;
                return false;
            }
        } else {
            if constexpr (__use_n) {
                return __atomic_compare_exchange_n(
                    ptr_, &expected, desired, false, __get_order(success), __get_order(failure)
                );
            } else {
                return __atomic_compare_exchange(
                    ptr_, &expected, &desired, false, __get_order(success), __get_order(failure)
                );
            }
        }
    }

    constexpr bool compare_exchange_weak(
        value_type& expected, value_type desired, memory_order order = memory_order::seq_cst
    ) const noexcept requires(!__isconst) {
