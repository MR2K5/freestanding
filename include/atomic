    constexpr T operator++(int) noexcept requires __pointer { return fetch_add(1); }
    T operator++(int) volatile noexcept requires is_always_lock_free && __pointer {
        return fetch_add(1);
    }
    constexpr T operator--(int) noexcept requires __pointer { return fetch_sub(1); }
    T operator--(int) volatile noexcept requires is_always_lock_free && __pointer {
