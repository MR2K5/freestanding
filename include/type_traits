// Common ref

// ============================================================================
// 1. Customization Point & Variadic Infrastructure
// ============================================================================

// Standard customization point template for user-defined proxy references
template<class T, class U, template<class> class TQual, template<class> class UQual>
struct basic_common_reference {};

// Variadic forward declarations
template<class... T> struct common_reference;
template<class... T> using common_reference_t = typename common_reference<T...>::type;

// 0 Types base case
template<> struct common_reference<> {};

// 1 Type base case
template<class T> struct common_reference<T> {
    using type = T;
};

// ============================================================================
// 2. Binary Resolution Engine (2 Types)
// ============================================================================
namespace __cr_det {
// Evaluates the ternary conditional expression result to preserve reference types
template<class T, class U> auto __cond_res(int) -> decltype(true ? declval<T>() : declval<U>());
template<class T, class U> auto __cond_res(...) -> void;
template<class T, class U> using __cond_res_t = decltype(__cond_res<T, U>(0));

// Base fallback struct
template<class T, class U, class = void> struct __binary_ref {};

// Path A: Ternary expression successfully resolves a common reference
template<class T, class U> requires(!__is_same(__cond_res_t<T, U>, void))
struct __binary_ref<T, U, void> {
    using type = __cond_res_t<T, U>;
};

// Path B: Ternary expression fails, fall back strictly to common_type conversion
template<class T, class U> requires(__is_same(__cond_res_t<T, U>, void)) && requires {
    typename common_type<T, U>::type;
} struct __binary_ref<T, U, void> {
    using type = typename common_type<T, U>::type;
};
}  // namespace __cr_det

// Primary 2-type evaluator inheriting the constrained resolution path
template<class T, class U> struct common_reference<T, U>: __cr_det::__binary_ref<T, U> {};

// ============================================================================
// 3. Variadic Reduction Loop (> 2 Types)
// ============================================================================
template<class T, class U, class... V> struct common_reference<T, U, V...> {
    using type = common_reference_t<common_reference_t<T, U>, V...>;
};

// ============================================================================
// The Concept-Based Swappable Engine (C++17 Traits via C++26 Concepts)
// ============================================================================
namespace __sw_det {
// 1. We declare a fallback swap signature inside a hidden namespace.
// This allows Argument-Dependent Lookup (ADL) to find user-defined swaps
// for custom types, while falling back to this rule for fundamental types.
template<class T>
void swap(T&, T&) noexcept(__is_nothrow_constructible(T, T&&) && __is_nothrow_assignable(T&, T&&))
    requires(__is_constructible(T, T &&) && __is_assignable(T&, T &&));

// 2. The Core evaluation concepts using standard C++ compound requirements
template<class T, class U>
concept __can_swap = requires {
    swap(declval<T>(), declval<U>());
    swap(declval<U>(), declval<T>());
};

template<class T, class U>
concept __can_swap_nothrow = __can_swap<T, U> && requires {
    requires noexcept(swap(declval<T>(), declval<U>()));
    requires noexcept(swap(declval<U>(), declval<T>()));
};
}  // namespace __sw_det

