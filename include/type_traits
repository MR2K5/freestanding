template<class T, class U>
inline constexpr bool is_nothrow_swappable_with_v = __sw_det::__can_swap_nothrow<T, U>;

template<class T>
inline constexpr bool is_nothrow_swappable_v =
    __sw_det::__can_swap_nothrow<add_lvalue_reference_t<T>, add_lvalue_reference_t<T>>;

