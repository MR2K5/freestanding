template<typename Target, typename... Ts> consteval size_t __index_of_type() noexcept {
    constexpr bool matches[] = {std::is_same_v<Target, Ts>...};
    size_t count             = 0;
    size_t match             = -1;

    for (size_t i = 0; i < sizeof...(Ts); ++i) {
        if (matches[i]) {
            ++count;
            match = i;
        };
    }
    return count == 1 ? match : size_t(-1);
}

template<typename Target, typename... Ts>
inline constexpr size_t __index_of_type_v = __index_of_type<Target, Ts...>();

