template<class T1, class T2>
constexpr pair<unwrap_ref_decay_t<T1>, unwrap_ref_decay_t<T2>> make_pair(T1&& x, T2&& y) {
    return pair<unwrap_ref_decay_t<T1>, unwrap_ref_decay_t<T2>>{FWD(x), FWD(y)};
}

template<class T1, class T2, class U1, class U2>
constexpr bool operator==(std::pair<T1, T2> const& lhs, std::pair<U1, U2> const& rhs)
    requires requires {
        { lhs.first == rhs.first } -> boolean_testable;
        { lhs.second == rhs.second } -> boolean_testable;
    } {
    return lhs.first == rhs.first && lhs.second == rhs.second;
}

template<class T1, class T2, class U1, class U2>
constexpr common_comparison_category_t<
    __synth_three_way_result<T1, U1>, __synth_three_way_result<T2, U2>>
operator<=>(std::pair<T1, T2> const& lhs, std::pair<U1, U2> const& rhs) requires requires {
    { lhs.first == rhs.first } -> boolean_testable;
    { lhs.second == rhs.second } -> boolean_testable;
} {
    if (auto x = __synth_three_way(lhs.first, rhs.first); x != 0) return x;
    return __synth_three_way(lhs.second, rhs.second);
}

template<class T1, class T2>
constexpr void swap(pair<T1, T2>& x, pair<T1, T2>& y) noexcept(noexcept(x.swap(y)))
    requires is_swappable_v<T1> && is_swappable_v<T2> {
    x.swap(y);
}
template<class T1, class T2>
constexpr void swap(pair<T1, T2> const& x, pair<T1, T2> const& y) noexcept(noexcept(x.swap(y)))
    requires is_swappable_v<T1 const> && is_swappable_v<T2 const> {
    x.swap(y);
}

