template<class T, class U> struct pair {
    using first_type  = T;
    using second_type = U;
    T first;
    U second;

    explicit(
        !__implicitly_default_constructible<T> || !__implicitly_default_constructible<U>
    ) constexpr pair() requires is_default_constructible_v<T> && is_default_constructible_v<U>
    = default;

    explicit(!is_convertible_v<T const&, T> || !is_convertible_v<U const&, U>) constexpr pair(
        T const& t, U const& u
    ) requires is_copy_constructible_v<T> && is_copy_constructible_v<U>
        : first(t), second(u) {}

    template<class T2 = T, class U2 = U>
    explicit(!is_convertible_v<T2, T> || !is_convertible_v<U2, U>) constexpr pair(T2&& t2, U2&& u2)
        requires is_constructible_v<T, T2> && is_constructible_v<U, U2>
        : first(FWD(t2)), second(FWD(u2)) {}

    template<class T2, class U2>
    explicit(!is_convertible_v<T2&, T> || !is_convertible_v<U2&, U>) constexpr pair(pair<T2, U2>& p)
        requires is_constructible_v<T, T2&> && is_constructible_v<U, U2&>
        : first(p.first), second(p.second) {}

    template<class T2, class U2>
    explicit(!is_convertible_v<T2 const&, T> || !is_convertible_v<U2 const&, U>) constexpr pair(
        pair<T2, U2> const& p
    ) requires is_constructible_v<T, T2 const&> && is_constructible_v<U, U2 const&>
        : first(p.first), second(p.second) {}

    template<class T2, class U2>
    explicit(!is_convertible_v<T2, T> || !is_convertible_v<U2, U>) constexpr pair(pair<T2, U2>&& p)
        requires is_constructible_v<T, T2> && is_constructible_v<U, U2>
        : first(FWD(p.first)), second(FWD(p.second)) {}

    template<class T2, class U2>
    explicit(!is_convertible_v<T2 const, T> || !is_convertible_v<U2 const, U>) constexpr pair(
        pair<T2, U2> const&& p
    ) requires is_constructible_v<T, T2 const> && is_constructible_v<U, U2 const>
        : first(FWD(p.first)), second(FWD(p.second)) {}

    template<__pair_like P>
    explicit(
        !is_convertible_v<decltype(std::get<0>(declval<P>())), T>
        || !is_convertible_v<decltype(std::get<1>(declval<P>())), U>
    ) constexpr pair(P&& p) requires(!__is_subrange_v<remove_cvref_t<P>>
                                     && is_constructible_v<T, decltype(std::get<0>(declval<P>()))>
                                     && is_constructible_v<U, decltype(std::get<1>(declval<P>()))>)
        : first(std::get<0>(FWD(p))), second(std::get<1>(FWD(p))) {}

    // TODO Needs tuple
    // template<class... As1, class... As2>
    // constexpr pair(piecewise_construct_t, )
    pair(pair const&) = default;
    pair(pair&&)      = default;

    constexpr pair& operator=(pair const&)
        requires is_copy_assignable_v<T> && is_copy_assignable_v<U> = default;

    constexpr pair const& operator=(pair const& o) const
        requires is_copy_assignable_v<T const> && is_copy_assignable_v<U const> {
        first  = o.first;
        second = o.second;
        return *this;
    }

    constexpr pair&
    operator=(pair&& o) noexcept(is_nothrow_move_assignable_v<T> && is_nothrow_move_assignable_v<U>)
        requires is_move_assignable_v<T> && is_move_assignable_v<U> = default;

    constexpr pair const& operator=(pair&& o) const
        requires is_assignable_v<T const&&, T> && is_assignable_v<U const&&, U> {
        first  = std::move(o.first);
        second = std::move(o.second);
        return *this;
    }

    template<class T2, class U2>
    constexpr pair& operator=(pair<T2, U2> const& o)
        requires is_assignable_v<T&, T2 const&> && is_assignable_v<U&, U2 const&> {
        first  = o.first;
        second = o.second;
        return *this;
    }
    template<class T2, class U2>
    constexpr pair const& operator=(pair<T2, U2> const& o) const
        requires is_assignable_v<T const&, T2 const&> && is_assignable_v<U const&, U2 const&> {
        first  = o.first;
        second = o.second;
        return *this;
    }

    template<class T2, class U2>
    constexpr pair& operator=(pair<T2, U2>&& o)
        requires is_assignable_v<T&, T2> && is_assignable_v<U&, U2> {
        first  = std::forward<T2>(o.first);
        second = std::forward<U2>(o.second);
        return *this;
    }
    template<class T2, class U2>
    constexpr pair const& operator=(pair<T2, U2>&& o) const
        requires is_assignable_v<T const&, T2> && is_assignable_v<U const&, U2> {
        first  = std::forward<T2>(o.first);
        second = std::forward<U2>(o.second);
        return *this;
    }

    template<__pair_like P>
    constexpr pair& operator=(P&& p) requires(
        !same_as<remove_cvref_t<P>, pair> && !__is_subrange_v<remove_cvref_t<P>>
        && is_assignable_v<T&, decltype(std::get<0>(FWD(p)))>
        && is_assignable_v<U&, decltype(std::get<1>(FWD(p)))>
    ) {
        first  = std::get<0>(FWD(p));
        second = std::get<1>(FWD(p));
        return *this;
    }
    template<__pair_like P>
    constexpr pair const& operator=(P&& p) const requires(
        !same_as<remove_cvref_t<P>, pair> && !__is_subrange_v<remove_cvref_t<P>>
        && is_assignable_v<T const&, decltype(std::get<0>(FWD(p)))>
        && is_assignable_v<U const&, decltype(std::get<1>(FWD(p)))>
    ) {
        first  = std::get<0>(FWD(p));
        second = std::get<1>(FWD(p));
        return *this;
    }

    constexpr void swap(pair& o) noexcept(is_nothrow_swappable_v<T> && is_nothrow_swappable_v<U>) {
        static_assert(is_swappable_v<T> && is_swappable_v<U>);
        using std::swap;
        swap(first, o.first);
        swap(second, o.second);
    }
    constexpr void swap(
        pair const& o
    ) const noexcept(is_nothrow_swappable_v<T const> && is_nothrow_swappable_v<U const>) {
        static_assert(is_swappable_v<T const> && is_swappable_v<U const>);
        using std::swap;
        swap(first, o.first);
        swap(second, o.second);
    }
};

