template<class T>
constexpr void swap(T& a, T& b) noexcept(
    std::is_nothrow_move_constructible<T>::value && std::is_nothrow_move_assignable<T>::value
) requires is_move_assignable_v<T> && is_move_assignable_v<T> {
    T tmp(std::move(a));
    a = std::move(b);
    b = std::move(tmp);
}

template<class T2, std::size_t N> void swap(T2 (&a)[N], T2 (&b)[N]) {
    using std::swap;
    for (size_t i = 0; i < N; ++i) swap(a[i], b[i]);
}

template<class T, class U = T>
constexpr T exchange(
    T& obj, U&& nw
) noexcept(is_nothrow_move_constructible_v<T> && is_nothrow_assignable_v<T&, U>) {
    T old = std::move(obj);
    obj   = FWD(nw);
    return old;
}

