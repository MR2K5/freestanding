#pragma once

#include <__functional/hash.hpp>
#include <__memory/base.hpp>
#include <compare>
#include <concepts>
#include <initializer_list>
#include <type_traits>
#include <utility>

namespace std {

template<class T> class optional;
template<class T>
concept __is_derived_from_optional = requires(T const& t) {
    []<class U>(optional<U> const&) {
    }(t);
};

struct nullopt_t {
    consteval nullopt_t(__empty) {}
};
inline constexpr nullopt_t nullopt{__empty{}};

template<class T> class optional {
private:
    union {
        char _ = {};
        T val;
    };
    bool is_active = false;

    static_assert(
        is_object_v<T> && !is_array_v<T> && !is_same_v<remove_cv_t<T>, in_place_t>
        && !is_same_v<remove_cv_t<T>, nullopt_t>
    );

public:
    using value_type     = T;
    using iterator       = T*;
    using const_iterator = T const*;

    constexpr optional() noexcept = default;
    constexpr optional(nullopt_t) noexcept {}

    constexpr optional(optional const&)
        requires is_copy_constructible_v<T> && is_trivially_copy_constructible_v<T> = default;

    constexpr optional(optional const& o) requires is_copy_constructible_v<T> {
        if (o.is_active) { std::construct_at(std::addressof(val), o.val); }
        is_active = o.is_active;
    }

    optional(optional const&) = delete;

    constexpr optional(optional&&) noexcept
        requires is_move_constructible_v<T> && is_trivially_move_constructible_v<T> = default;

    constexpr optional(optional&& o) noexcept(is_nothrow_move_constructible_v<T>)
        requires is_move_constructible_v<T> {
        if (o.is_active) { std::construct_at(std::addressof(val), std::move(o.val)); }
        is_active = o.is_active;
    }

    optional(optional&&) = delete;

    template<class... As>
    constexpr explicit optional(
        in_place_t, As&&... as
    ) noexcept(is_nothrow_constructible_v<T, As...>) requires is_constructible_v<T, As...>
        : val(FWD(as)...), is_active(true) {}

    template<class U, class... As>
    constexpr explicit optional(in_place_t, initializer_list<U> il, As&&... as) noexcept(
        is_nothrow_constructible_v<T, initializer_list<U>, As...>
    ) requires is_constructible_v<T, initializer_list<U>, As...>
        : val(il, FWD(as)...), is_active(true) {}

    template<class U = remove_cvref_t<T>>
    constexpr explicit(!is_convertible_v<U, T>) optional(U&& v) noexcept(
        is_nothrow_constructible_v<T, U>
    ) requires is_constructible_v<T, U> && (!is_same_v<remove_cvref_t<U>, in_place_t>)
                && (!is_same_v<remove_cvref_t<U>, optional>)
                && (!is_same_v<remove_cv_t<T>, bool>
                    || !__is_specialization_of_v<optional, remove_cvref_t<U>>)
        : val(FWD(v)), is_active(true) {}

    template<class U>
    constexpr explicit(!is_convertible_v<U const&, T>) optional(optional<U> const& u) noexcept(
        is_nothrow_constructible_v<T, U const&>
    ) requires is_constructible_v<T, U const&>
            && (is_same_v<bool, remove_cv_t<U>> || !__converts_from_any_cvref<T, optional<U>>) {
        if (u.is_active) { std::construct_at(std::addressof(val), u.value); }
        is_active = u.is_active;
    }

    template<class U>
    constexpr explicit(!is_convertible_v<U, T>) optional(optional<U>&& u) noexcept(
        is_nothrow_constructible_v<T, U>
    ) requires is_constructible_v<T, U>
            && (is_same_v<bool, remove_cv_t<U>> || !__converts_from_any_cvref<T, optional<U>>) {
        if (u.is_active) { std::construct_at(std::addressof(val), std::move(u.value)); }
        is_active = u.is_active;
    }

    constexpr ~optional() requires is_trivially_destructible_v<T> = default;
    constexpr ~optional() {
        if (is_active) val.~T();
    }

    constexpr optional& operator=(nullopt_t) noexcept {
        if (is_active) val.~T();
        is_active = false;
    }

    constexpr optional& operator=(optional const&) = delete;
    constexpr optional& operator=(optional const&)
        requires is_copy_constructible_v<T> && is_copy_assignable_v<T>
                  && is_trivially_copy_constructible_v<T> && is_trivially_copy_assignable_v<T>
        = default;

    constexpr optional& operator=(optional const& o) noexcept(
        is_nothrow_copy_constructible_v<T> && is_nothrow_copy_assignable_v<T>
    ) requires is_copy_constructible_v<T> && is_copy_assignable_v<T> {
        if (is_active) {
            if (o.is_active) {
                val = o.val;
            } else {
                val.~T();
            }
        } else {
            if (o.is_active) { std::construct_at(std::addressof(val), o.val); }
        }
        is_active = o.is_active;
        return *this;
    }

    constexpr optional& operator=(optional&&) = delete;
    constexpr optional& operator=(optional&&)
        requires is_move_constructible_v<T> && is_move_assignable_v<T>
                  && is_trivially_move_constructible_v<T> && is_trivially_move_assignable_v<T>
        = default;

    constexpr optional& operator=(optional&& o) noexcept(
        is_nothrow_move_assignable_v<T> && is_nothrow_move_constructible_v<T>
    ) requires is_move_constructible_v<T> && is_move_assignable_v<T> {
        if (is_active) {
            if (o.is_active) {
                val = std::move(o.val);
            } else {
                val.~T();
            }
        } else {
            if (o.is_active) { std::construct_at(std::addressof(val), std::move(o.val)); }
        }
        is_active = o.is_active;
        return *this;
    }

    template<class U = remove_cv_t<T>>
    constexpr optional&
    operator=(U&& v) noexcept(is_nothrow_constructible_v<T, U> && is_nothrow_assignable_v<T&, U>)
        requires(!is_same_v<remove_cvref_t<U>, optional>)
             && (!conjunction_v<is_scalar<T>, is_same<T, decay_t<U>>>)
             && is_constructible_v<T, U> && is_assignable_v<T&, U> {
        if (is_active)
            val = FWD(v);
        else
            std::construct_at(std::addressof(val), FWD(v));
        is_active = true;
        return *this;
    }

    template<class U>
    constexpr optional<T>& operator=(optional<U> const& u) noexcept(
        is_nothrow_constructible_v<T, U const&> && is_nothrow_assignable_v<T&, U const&>
    ) requires is_constructible_v<T, U const&> && is_assignable_v<T&, U const&>
            && (!__converts_from_any_cvref<T, optional<U>>) && (!is_assignable_v<T&, optional<U>&>)
            && (!is_assignable_v<T&, optional<U> &&>) && (!is_assignable_v<T&, optional<U> const&>)
            && (!is_assignable_v<T&, optional<U> const &&>) {
        if (is_active) {
            if (u.is_active)
                val = u.value;
            else
                val.~T();
        } else {
            if (u.is_active) std::construct_at(std::addressof(val), u.value);
        }
        is_active = u.is_active;
        return *this;
    }

    template<class U>
    constexpr optional<T>& operator=(optional<U>&& u) noexcept(
        is_nothrow_constructible_v<T, U> && is_nothrow_assignable_v<T&, U>
    ) requires is_constructible_v<T, U> && is_assignable_v<T&, U>
            && (!__converts_from_any_cvref<T, optional<U>>) && (!is_assignable_v<T&, optional<U>&>)
            && (!is_assignable_v<T&, optional<U> &&>) && (!is_assignable_v<T&, optional<U> const&>)
            && (!is_assignable_v<T&, optional<U> const &&>) {
        if (is_active) {
            if (u.is_active)
                val = std::move(u.value);
            else
                val.~T();
        } else {
            if (u.is_active) std::construct_at(std::addressof(val), std::move(u.value));
        }
        is_active = u.is_active;
        return *this;
    }

    template<class... As>
    constexpr T& emplace(As&&... as) noexcept(is_nothrow_constructible_v<T, As...>)
        requires is_constructible_v<T, As...> {
        *this = nullopt;
        std::construct_at(std::addressof(val), FWD(as)...);
        is_active = true;
        return val;
    }
    template<class U, class... As>
    constexpr T& emplace(initializer_list<U> il, As&&... as) noexcept(
        is_nothrow_constructible_v<T, initializer_list<U>, As...>
    ) requires is_constructible_v<T, initializer_list<U>, As...> {
        *this = nullopt;
        std::construct_at(std::addressof(val), il, FWD(as)...);
        is_active = true;
        return val;
    }

    constexpr void
    swap(optional& o) noexcept(is_nothrow_swappable_v<T> && is_nothrow_move_constructible_v<T>) {
        static_assert(is_move_constructible_v<T> && is_swappable_v<T>);
        using std::swap;
        if (is_active) {
            if (o.is_active) {
                swap(val, o.val);
            } else {
                std::construct_at(std::addressof(o.val), std::move(val));
                val.~T();
            }
        } else {
            if (o.is_active) { std::construct_at(std::addressof(val), std::move(o.val)); }
        }
        swap(is_active, o.is_active);
    }

    constexpr iterator begin() noexcept { return std::addressof(val); }
    constexpr const_iterator begin() const noexcept { return std::addressof(val); }
    constexpr iterator end() noexcept { return begin() + is_active; }
    constexpr const_iterator end() const noexcept { return begin() + is_active; }

    constexpr T const* operator->() const noexcept { return std::addressof(val); }
    constexpr T* operator->() noexcept { return std::addressof(val); }
    constexpr T const& operator*() const& noexcept { return val; }
    constexpr T& operator*() & noexcept { return val; }
    constexpr T const&& operator*() const&& noexcept { return std::move(val); }
    constexpr T&& operator*() && noexcept { return std::move(val); }

    constexpr explicit operator bool() const noexcept { return is_active; }
    constexpr bool has_value() const noexcept { return is_active; }

    constexpr T const& value() const&   = delete ("TODO: needs exceptions");
    constexpr T& value() &              = delete ("TODO: needs exceptions");
    constexpr T&& value() &&            = delete ("TODO: needs exceptions");
    constexpr T const&& value() const&& = delete ("TODO: needs exceptions");

    template<class U = remove_cv_t<T>> constexpr T value_or(U&& v) const& {
        static_assert(is_copy_constructible_v<T> && is_convertible_v<U&&, T>);
        return has_value() ? val : static_cast<T>(FWD(v));
    }
    template<class U = remove_cv_t<T>> constexpr T value_or(U&& v) && {
        static_assert(is_copy_constructible_v<T> && is_convertible_v<U&&, T>);
        return has_value() ? std::move(val) : static_cast<T>(FWD(v));
    }

    template<class Self, class F> constexpr auto and_then(this Self&& self, F&& f) {
        using R = invoke_result_t<F, decltype(*FWD(self))>;
        static_assert(__is_specialization_of_v<optional, R>);

        if (self) {
            return std::invoke(FWD(f), *FWD(self));
        } else {
            return remove_cvref_t<R>();
        }
    }

    template<class Self, class F> constexpr auto transform(this Self&& self, F&& f) {
        using U = remove_cv_t<invoke_result_t<F, decltype(*FWD(self))>>;
        static_assert(requires { U(std::invoke(FWD(f), *FWD(self))); });

        if (self) {
            return optional<U>(std::invoke(FWD(f), *FWD(self)));
        } else {
            return optional<U>();
        }
    }

    template<invocable F> constexpr optional or_else(F&& f) const& requires copy_constructible<T> {
        static_assert(is_same_v<remove_cvref_t<invoke_result_t<F>>, optional>);
        if (*this) {
            return *this;
        } else {
            return FWD(f)();
        }
    }
    template<invocable F> constexpr optional or_else(F&& f) && requires move_constructible<T> {
        static_assert(is_same_v<remove_cvref_t<invoke_result_t<F>>, optional>);
        if (*this) {
            return std::move(*this);
        } else {
            return FWD(f)();
        }
    }

    constexpr void reset() noexcept {
        if (is_active) val.~T();
        is_active = false;
    }
};

template<class T> optional(T) -> optional<T>;

template<class T> struct __optional_ref_iter {
    using iterator = T*;
};
template<class T> requires(!is_unbounded_array_v<T>) struct __optional_ref_iter<T> {};

template<class T> class optional<T&>: __optional_ref_iter<T> {
    T* ptr = nullptr;

    template<class U> constexpr void convert_ref_init_val(U&& u) {
        T& r(FWD(u));
        ptr = std::addressof(r);
    }

    static_assert(
        !is_same_v<remove_cvref_t<T>, in_place_t> && !is_same_v<remove_cvref_t<T>, nullopt_t>
    );

public:
    using value_type = T;
    using iterator   = T*;

    constexpr optional() noexcept = default;
    constexpr optional(nullopt_t) noexcept {}
    constexpr optional(optional const&) = default;

    template<class Arg>
    constexpr explicit optional(in_place_t, Arg&& arg) noexcept(is_nothrow_constructible_v<T&, Arg>)
        requires is_constructible_v<T&, Arg> && (!reference_constructs_from_temporary_v<T&, Arg>) {
        convert_ref_init_val(FWD(arg));
    }

    template<class U>
    constexpr explicit(!is_convertible_v<U, T&>) optional(U&& u) noexcept(
        is_nothrow_constructible_v<T&, U>
    ) requires(!is_same_v<remove_cvref_t<U>, optional>)
           && (!is_same_v<remove_cvref_t<U>, in_place_t>) && is_constructible_v<T&, U> {
        convert_ref_init_val(FWD(u));
    }

    template<class U>
    constexpr optional(U&& u)
        requires(!is_same_v<remove_cvref_t<U>, optional>)
                 && (!is_same_v<remove_cvref_t<U>, in_place_t>) && is_constructible_v<T&, U>
                 && reference_constructs_from_temporary_v<T&, U> = delete;

#define _DECL_CTOR(qual, qual2)                                                                    \
    template<class U>                                                                              \
    constexpr explicit(!is_convertible_v<U qual2, T&>)                                             \
        optional(optional<U> qual rhs) noexcept(is_nothrow_constructible_v<T&, U qual2>)           \
            requires(!is_same_v<remove_cv_t<T>, optional<U>>) && (!is_same_v<T&, U>)               \
                 && is_constructible_v<T&, U qual2> {                                              \
        if (rhs.has_value()) convert_ref_init_val(*FWD(rhs));                                      \
    }                                                                                              \
                                                                                                   \
    template<class U>                                                                              \
    constexpr optional(optional<U> qual rhs)                                                       \
        requires(!is_same_v<remove_cv_t<T>, optional<U>>) && (!is_same_v<T&, U>)                   \
                 && is_constructible_v<T&, U qual2>                                                \
                 && reference_constructs_from_temporary_v<T&, U qual2> = delete;

    _DECL_CTOR(&, &)
    _DECL_CTOR(const&, const&)
    _DECL_CTOR(&&, )
    _DECL_CTOR(const&&, const)
#undef _DECL_CTOR

    constexpr optional& operator=(nullopt_t) noexcept {
        ptr = nullptr;
        return *this;
    }
    template<class U>
    constexpr T& emplace(U&& u) noexcept(is_nothrow_constructible_v<T&, U>)
        requires is_constructible_v<T&, U> && (!reference_constructs_from_temporary_v<T&, U>) {
        convert_ref_init_val(FWD(u));
    }

    constexpr void swap(optional& o) noexcept { std::swap(ptr, o.ptr); }

    constexpr auto begin() const noexcept requires(!is_unbounded_array_v<T>) { return ptr; }
    constexpr auto end() const noexcept requires(!is_unbounded_array_v<T>) {
        return ptr + has_value();
    }

    constexpr T* operator->() const noexcept { return ptr; }
    constexpr T& operator*() const noexcept { return *ptr; }
    constexpr explicit operator bool() const noexcept { return ptr != nullptr; }
    constexpr bool has_value() const noexcept { return ptr != nullptr; }

    constexpr T& value() const = delete ("TODO: exceptions");

    template<class U = remove_cv_t<T>>
    constexpr remove_cv_t<T> value_or(U&& u) const requires(!is_array_v<T> && is_object_v<T>) {
        using X = remove_cv_t<T>;
        static_assert(is_constructible_v<X, T&> && is_convertible_v<U, X>);
        return has_value() ? *ptr : static_cast<X>(FWD(u));
    }

    template<class F> constexpr auto and_then(F&& f) const {
        using U = invoke_result_t<F, T&>;
        static_assert(__is_specialization_of_v<optional, remove_cvref_t<U>>);
        if (has_value()) {
            return std::invoke(FWD(f), *ptr);
        } else {
            return remove_cvref_t<U>();
        }
    }

    template<class F>
    constexpr optional<remove_cv_t<invoke_result_t<F, T&>>> transform(F&& f) const {
        using U = remove_cv_t<invoke_result_t<F, T&>>;
        static_assert(requires { U(std::invoke(FWD(f), *ptr)); });
        if (has_value()) {
            return optional<U>(std::invoke(FWD(f), *ptr));
        } else {
            return optional<U>();
        }
    }

    template<class F> constexpr optional or_else(F&& f) const requires invocable<F> {
        static_assert(is_same_v<remove_cvref_t<invoke_result_t<F>>, optional>);
        if (has_value()) {
            return *ptr;
        } else {
            return FWD(f)();
        }
    }

    constexpr void reset() const noexcept { ptr = nullptr; }
};

template<class T, class U>
constexpr bool operator==(optional<T> const& x, optional<U> const& y) requires requires {
    { *x == *y } -> boolean_testable;
} {
    if (x.has_value() != y.has_value()) return false;
    if (!x.has_value()) return true;
    return *x == *y;
}

template<class T, three_way_comparable_with<T> U>
constexpr compare_three_way_result_t<T, U> operator<=>(optional<T> const& x, optional<U> const& y) {
    if (x && y) return *x <=> *y;
    return x.has_value() <=> y.has_value();
}

template<class T> constexpr bool operator==(optional<T> const& x, nullopt_t) noexcept {
    return !x;
}
template<class T> constexpr strong_ordering operator<=>(optional<T> const& x, nullopt_t) noexcept {
    return x.has_value() <=> false;
}

template<class T, class U>
constexpr bool operator==(optional<T> const& x, U const& v)
    requires(!__is_specialization_of_v<optional, remove_cvref_t<U>>) && requires {
        { *x == v } -> boolean_testable;
    } {
    if (x.has_value()) return *x == v;
    return false;
}

template<class T, class U>
requires(!__is_derived_from_optional<U>) && three_way_comparable_with<T, U>
constexpr compare_three_way_result_t<T, U> operator<=>(optional<T> const& x, U const& v) {
    return x.has_value() ? *x <=> v : strong_ordering::less;
}

template<class T>
requires is_reference_v<T> || (is_move_constructible_v<T> && is_swappable_v<T>)constexpr void
swap(optional<T>& x, optional<T>& y) noexcept(noexcept(x.swap(y))) {
    x.swap(y);
}

template<auto = nullptr, class T> constexpr optional<decay_t<T>> make_optional(T&& v) {
    return optional<decay_t<T>>(FWD(v));
}

template<class T> constexpr optional<T> make_optional(auto&&... as) {
    return optional<T>(in_place, FWD(as)...);
}
template<class T, class U>
constexpr optional<T> make_optional(initializer_list<U> il, auto&&... as) {
    return optional<T>(in_place, il, FWD(as)...);
}

namespace __detail {
template<class T> concept __object = is_object_v<T>;

template<class T> requires move_constructible<T> && __object<T>
class movable_box: private optional<T> {
    using B = optional<T>;

public:
    using B::B;
    using B::operator=;
    using B::operator*;
    using B::operator->;
    using B::operator bool;
    using B::emplace;
    using B::has_value;
    using B::reset;

    constexpr movable_box() noexcept(is_nothrow_default_constructible_v<T>)
        requires default_initializable<T>
        : B(std::in_place) {}

    constexpr movable_box& operator=(movable_box&& o) noexcept(is_nothrow_move_constructible_v<T>)
        requires movable<T> {
        if (this != &o) {
            if (o)
                emplace(std::move(*o));
            else
                reset();
        }
        return *this;
    }
    constexpr movable_box&
    operator=(movable_box const& o) noexcept(is_nothrow_copy_constructible_v<T>)
        requires(!copyable<T> && copy_constructible<T>) {
        if (this != &o) {
            if (o)
                emplace(*o);
            else
                reset();
        }
        return *this;
    }
};

template<class T> requires move_constructible<T> && __object<T>
                        && (copyable<T>
                            || (copy_constructible<T> && is_nothrow_move_constructible_v<T>
                                && is_nothrow_copy_constructible_v<T>)
                            || (!copy_constructible<T> && movable<T>)
                            || (!copy_constructible<T> && is_nothrow_move_constructible_v<T>))
class movable_box<T> {
public:
    constexpr movable_box() noexcept(is_nothrow_default_constructible_v<T>)
        requires default_initializable<T> = default;

    movable_box(movable_box const&) = default;
    movable_box(movable_box&&)      = default;

    movable_box& operator=(movable_box const&) = default;
    movable_box& operator=(movable_box&&)      = default;

    movable_box& operator=(movable_box&& o) noexcept requires(!movable<T>) {
        static_assert(is_nothrow_move_constructible_v<T>);
        if (this != &o) {
            obj_.~T();
            std::construct_at(std::addressof(obj_), std::move(o.obj_));
        }
        return *this;
    }
    movable_box& operator=(movable_box const& o) noexcept
        requires(!copyable<T> && copy_constructible<T>) {
        static_assert(is_nothrow_copy_constructible_v<T>);
        if (this != &o) {
            obj_.~T();
            std::construct_at(std::addressof(obj_), o.obj_);
        }
        return *this;
    }

    constexpr T& operator*() noexcept { return obj_; }
    constexpr T const& operator*() const noexcept { return obj_; }
    constexpr T* operator->() noexcept { return std::addressof(obj_); }
    constexpr T const* operator->() const noexcept { return std::addressof(obj_); }
    constexpr bool has_value() const noexcept { return true; }
    constexpr explicit operator bool() const noexcept { return true; }

    template<class... As> requires is_constructible_v<T, As...>
    constexpr movable_box(in_place_t, As&&... as) noexcept(is_nothrow_constructible_v<T, As...>)
        : obj_(std::forward<As>(as)...) {}

    template<class U = T> requires is_constructible_v<T, U>
                                && (!is_same_v<remove_cvref_t<U>, in_place_t>
                                    && !is_same_v<remove_cvref_t<U>, movable_box>)
                                && (!is_same_v<remove_cv_t<T>, bool>
                                    || !__is_specialization_of_v<optional, remove_cvref_t<U>>)
    explicit(!is_convertible_v<U, T>) constexpr movable_box(U&& u): obj_(std::forward<U>(u)) {}

private:
    T obj_;
};

template<class T> movable_box(T) -> movable_box<T>;

template<class T> requires is_object_v<T> class non_propagating_cache: optional<T> {
    using B = optional<T>;

public:
    using B::B;
    using B::operator=;
    using B::operator*;
    using B::operator->;
    using B::operator bool;
    using B::emplace;
    using B::has_value;
    using B::reset;

    constexpr non_propagating_cache(non_propagating_cache const&) noexcept {}
    constexpr non_propagating_cache(non_propagating_cache&& o) noexcept { o.reset(); }

    constexpr non_propagating_cache& operator=(non_propagating_cache const& other) noexcept {
        if (std::addressof(other) != this) reset();
        return *this;
    }
    constexpr non_propagating_cache& operator=(non_propagating_cache&& other) noexcept {
        reset();
        other.reset();
        return *this;
    }
    template<class I> constexpr T& __emplace_deref(I const& i) {
        static_assert(requires { ::new T(*i); });
        reset();
        return emplace(*i);
    }
};

}  // namespace __detail

template<class T> struct hash<optional<T>> {
    static constexpr size_t operator()(optional<T> const& t) {
        if (t.has_value()) {
            return __detail::__do_hash(*t);
        } else {
            return 0;
        }
    }
};

