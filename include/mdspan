template<class OffsetType, class ExtentType, class StrideType> struct extent_slice {
    using offset_type = OffsetType;
    using extent_type = ExtentType;
    using stride_type = StrideType;

    [[no_unique_address]] offset_type offset{};
    [[no_unique_address]] extent_type extent{};
    [[no_unique_address]] stride_type stride{};
};

template<class FirstType, class LastType, class StrideType = constant_wrapper<1zu>>
struct range_slice {
    using first_type  = FirstType;
    using last_type   = LastType;
    using stride_type = StrideType;

    [[no_unique_address]] FirstType first{};
    [[no_unique_address]] LastType last{};
    [[no_unique_address]] StrideType stride{};
};

template<class T> concept __is_extent_slice = __is_specialization_of_v<extent_slice, T>;
template<class T> concept __is_range_slice  = __is_specialization_of_v<range_slice, T>;

template<class IndexType, class S> constexpr auto __canonical_index(S s) {
    if constexpr (__integral_constant_like<S>) {
        static_assert(std::in_range<IndexType>(extents<IndexType>::__index_cast(std::move(s))));
        return cw<IndexType(S::value)>;
    } else {
        return IndexType(std::move(s));
    }
}

template<class IndexType, class OffsetType, class SpanType, class... StrideTypes>
constexpr auto __canonical_slice_range(OffsetType offset, SpanType span, StrideTypes... strides) {
    static_assert(sizeof...(StrideTypes) <= 1);

    using StrideType = decltype([] {
        if constexpr (sizeof...(StrideTypes) == 0 || (requires {
                          requires __is_constant_wrapper_v<SpanType>;
                          requires same_as<typename SpanType::value_type, IndexType>;
                          requires SpanType::value == 0;
                      })) {
            return type_identity<constant_wrapper<IndexType(1)>>();
        } else {
            if constexpr (__is_constant_wrapper_v<StrideTypes...[0]>)
                static_assert(StrideTypes...[0] ::value > 0);
            return type_identity<StrideTypes...[0]>();
        }
    }())::type;

    auto stride = [&] -> StrideType {
        if constexpr (__is_constant_wrapper_v<StrideType>) {
            return StrideType();
        } else if (span == 0) {
            return IndexType(1);
        } else {
            return strides...[0];
        }
    }();
    assert(stride > 0);

    auto extent = [&] {
        if constexpr (__is_constant_wrapper_v<SpanType> && __is_constant_wrapper_v<StrideType>) {
            return cw<IndexType(
                SpanType::value != 0 ? 1 + (SpanType::value - 1) / StrideType::value : 0
            )>;
        } else {
            auto extent_value = span != 0 ? 1 + (span - 1) / stride : 0;
            return IndexType(extent_value);
        }
    }();

    return extent_slice{.offset = offset, .extent = extent, .stride = stride};
}

template<class LayoutMapping> struct submdspan_mapping_result {
    [[no_unique_address]] LayoutMapping mapping = LayoutMapping();
