template<class IndexType, size_t... Extents> class extents {
    static_assert(integral<IndexType>);
    static_assert(((Extents == dynamic_extent || std::in_range<IndexType>(Extents)) && ...));

public:
    using index_type = IndexType;
    using size_type  = make_unsigned_t<index_type>;
    using rank_type  = size_t;

    static constexpr std::array<size_t, sizeof...(Extents)> exts_{Extents...};

    // [mdspan.extents.obs], observers of the multidimensional index space
    static consteval rank_type rank() noexcept { return sizeof...(Extents); }
    static consteval rank_type rank_dynamic() noexcept { return __dynamic_index(rank()); }
    static constexpr size_t static_extent(rank_type i) noexcept {
        assert(i < rank());
        return exts_[i];
    }
    constexpr index_type extent(rank_type i) const noexcept {
        assert(i < rank());
        if (static_extent(i) != dynamic_extent) return static_extent(i);
        return __dynamic_extents[__dynamic_index(i)];
    }

    // [mdspan.extents.cons], constructors
    constexpr extents() noexcept = default;

    template<class OtherIndexType, size_t... OtherExtents>
    requires(sizeof...(OtherExtents) == rank())
         && ((OtherExtents == dynamic_extent || Extents == dynamic_extent
              || OtherExtents == Extents)
             && ...)
    constexpr explicit(
        (((Extents != dynamic_extent) && (OtherExtents == dynamic_extent)) || ...)
        || (numeric_limits<index_type>::max() < numeric_limits<OtherIndexType>::max())
    ) extents(extents<OtherIndexType, OtherExtents...> const& o) noexcept {
        for (rank_type i = 0; i < rank(); ++i) {
            if (static_extent(i) != dynamic_extent)
                assert(static_extent(i) == o.extent(i));
            else
                __dynamic_extents[__dynamic_index(i)] = o.extent(i);
        }
    }

    template<class... OtherIndexTypes>
    requires(is_convertible_v<OtherIndexTypes, index_type> && ...)
         && (is_nothrow_constructible_v<index_type, OtherIndexTypes> && ...)
         && (sizeof...(OtherIndexTypes) == rank_dynamic() || sizeof...(OtherIndexTypes) == rank())
    constexpr explicit extents(OtherIndexTypes... o) noexcept
        : extents(
              array<index_type, sizeof...(OtherIndexTypes)>{
                  static_cast<index_type>(std::move(o))...
              }
          ) {
        if constexpr (
            sizeof...(OtherIndexTypes) != rank_dynamic() && (integral<OtherIndexTypes> && ...)
        ) {
            array<index_type, sizeof...(OtherIndexTypes)> exts_arr{
                static_cast<index_type>(o)...
            };  // Only for integral types. use-after-move is ok
            for (size_t k = 0; k < rank(); ++k) {
                if (static_extent(k) != dynamic_extent) assert(static_extent(k) == exts_arr[k]);
            }
        }
    }

    template<class OtherIndexType, size_t N>
    requires is_convertible_v<OtherIndexType const&, index_type>
          && is_nothrow_constructible_v<index_type, OtherIndexType const&>
          && (N == rank_dynamic() || N == rank())
    constexpr explicit(N != rank_dynamic()) extents(span<OtherIndexType, N> o) noexcept {
        if constexpr (N == rank_dynamic()) {
            for (rank_type i = 0; i < rank_dynamic(); ++i) __dynamic_extents[i] = o[i];
        } else {
            for (rank_type i = 0; i < rank(); ++i) {
                if (static_extent(i) != dynamic_extent)
                    assert(static_extent(i) == o[i]);
                else
                    __dynamic_extents[__dynamic_index(i)] = o[i];
            }
        }
    }

    template<class OtherIndexType, size_t N>
    requires is_convertible_v<OtherIndexType const&, index_type>
          && is_nothrow_constructible_v<index_type, OtherIndexType const&>
          && (N == rank_dynamic() || N == rank())
    constexpr explicit(N != rank_dynamic()) extents(array<OtherIndexType, N> const& arr) noexcept
        : extents(span(arr)) {}

    // [mdspan.extents.cmp], comparison operators
    template<class OtherIndexType, size_t... OtherExtents>
    friend constexpr bool
    operator==(extents const& x, extents<OtherIndexType, OtherExtents...> const& y) noexcept {
        if (x.rank() != y.rank()) return false;
        for (rank_type i = 0; i < x.rank(); ++i) {
            if (x.extent(i) != y.extent(i)) return false;
        }
        return true;
    }

    // [mdspan.extents.expo], exposition-only helpers
    constexpr size_t __fwd_prod_of_extents(rank_type i) const noexcept {
        assert(i <= rank());
        size_t r = 1;
        for (rank_type j = 0; j < i; ++j) r *= extent(j);
        return r;
    }
    constexpr size_t __rev_prod_of_extents(rank_type i) const noexcept {
        assert(i < rank());
        size_t prod = 1;
        for (rank_type k = i + 1; k < rank(); ++k) { prod *= static_cast<size_t>(extent(k)); }
        return prod;
    }
    template<class OtherIndexType> static constexpr auto __index_cast(OtherIndexType&& o) noexcept {
        if constexpr (integral<remove_cvref_t<OtherIndexType>>) {
            return o;
        } else {
            return static_cast<index_type>(FWD(o));
        }
    }

    template<size_t... Is, class... Idx>
    constexpr bool __is_in_range(index_sequence<Is...>, Idx const&... idx) {
        return ((idx < extent(Is)) && ...);
    }

private:
    static constexpr rank_type __dynamic_index(rank_type r) noexcept {
        assert(r <= rank());
        rank_type res = 0;
        for (rank_type i = 0; i < r; ++i)
            if (exts_[i] == dynamic_extent) ++res;
        return res;
    }
    static constexpr rank_type __dynamic_index_inv(rank_type i) noexcept {
        assert(i < rank_dynamic());
        rank_type count = 0;
        for (rank_type r = 0; r < rank(); ++r) {
            if (exts_[r] == dynamic_extent) {
                if (count == i) { return r; }
                ++count;
            }
        }
        unreachable();
    }

    array<index_type, rank_dynamic()> __dynamic_extents{};
};

