    requires(sizeof...(TTypes) == sizeof...(UTypes))
         && (__tuple_has_equal<tuple<TTypes...>, tuple<UTypes...>>()) {
    auto& [... ts] = t;
    auto& [... us] = u;
    return ((ts == us) && ...);
}

template<class... TTypes, __tuple_like U>
requires(!__is_specialization_of_v<tuple, remove_cvref_t<U>>)
constexpr bool operator==(tuple<TTypes...> const& t, U const& u)
    requires(sizeof...(TTypes) == tuple_size_v<remove_cvref_t<U>>)
         && (__tuple_has_equal<tuple<TTypes...>, U>()) {
    auto& [... ts] = t;
    auto& [... us] = u;
    return ((ts == us) && ...);
}

template<class... TTypes, class... UTypes>
constexpr common_comparison_category_t<__synth_three_way_result<TTypes, UTypes>...>
operator<=>(tuple<TTypes...> const& t, tuple<UTypes...> const& u) {
    auto& [... ts] = t;
    auto& [... us] = u;

    auto impl = [&]<size_t I = 0>(this auto&& self) {
        if constexpr (I == sizeof...(ts)) {
            return strong_ordering::equal;
        } else {
            if (auto c = __synth_three_way(ts...[I], us...[I]); c != 0) return c;
            return self.template operator()<I + 1>();
        }
    };
    return impl();
}

template<class U, class... Ts> consteval auto __tuple_three_way_return() {
    return decltype([](U const& u) {
        auto& [... us] = u;
        static_assert(is_void_v<decltype(us)...>);
        static_assert(sizeof...(us) == sizeof...(Ts));
        return common_comparison_category_t<__synth_three_way_result<Ts, decltype(us)>...>::less;
    }(declval<U const&>()))::less;
}

template<class... TTypes, __tuple_like U>
requires(!__is_specialization_of_v<tuple, remove_cvref_t<U>>)
constexpr decltype(__tuple_three_way_return<U, TTypes...>())
operator<=>(tuple<TTypes...> const& t, U const& u) {
    auto& [... ts] = t;
    auto& [... us] = u;

    auto impl = [&]<size_t I = 0>(this auto&& self) {
        if constexpr (I == sizeof...(ts)) {
            return strong_ordering::equal;
        } else {
            if (auto c = __synth_three_way(ts...[I], us...[I]); c != 0) return c;
            return self.template operator()<I + 1>();
        }
    };
    return impl();
}

