namespace __detail {
template<class F, class Tuple> constexpr auto __tuple_transform(F&& f, Tuple&& tuple) {
    return std::apply(
        [&]<class... Ts>(Ts&&... args) {
            return std::tuple<invoke_result_t<F&, Ts>...>(std::invoke(f, FWD(args))...);
        },
        FWD(tuple)
    );
}

template<class F, class Tuple> constexpr void __tuple_for_each(F&& f, Tuple&& tuple) {
    std::apply(
        [&]<class... Ts>(Ts&&... args) { (static_cast<void>(std::invoke(f, FWD(args))), ...); },
        FWD(tuple)
    );
}

