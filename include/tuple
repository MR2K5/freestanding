template<class T, class U> consteval bool __tuple_has_equal() {
    return decltype([](T const& x, U const& y) {
        auto& [... ts] = x;
        auto& [... us] = y;
        return bool_constant<(requires {
            { ts == us } -> boolean_testable;
        } && ...)>();
    }(declval<T const&>(), declval<U const&>()))::value;
}

