    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug ARM QEMU (lldb-dap)",
            "program": "${workspaceFolder}/build-armv7/main",
            "launchCommands": [
                "target create ${workspaceFolder}/build-armv7/main",
                "gdb-remote localhost:1234",
            ],
            "postRunCommands": [
                "register read pc sp"
            ]
        }
    ]
}